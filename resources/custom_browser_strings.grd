      </message>
      <!-- Remote access: the tray tooltip line and the quit confirmation (F-24) -->
      <message name="IDS_NEXUS_TRAY_REMOTE_ACCESS_DEVICES" desc="Second line of the system-tray icon tooltip while remote access is on: how many remote devices are connected to this computer" use_name_for_id="true">
        {COUNT, plural,
          =0 {Remote access: no devices connected}
          =1 {Remote access: # device connected}
          other {Remote access: # devices connected}}
      </message>
      <message name="IDS_NEXUS_QUIT_REMOTE_DEVICES_TITLE" desc="Title of the dialog shown when the user quits the app (tray menu Quit or the app menu's Exit) while remote devices are connected through remote access. Answered with Yes / No." use_name_for_id="true">
        Quit <ph name="PRODUCT_NAME">$1<ex>Velloc</ex></ph>?
      </message>
      <message name="IDS_NEXUS_QUIT_REMOTE_DEVICES_BODY" desc="Body of the dialog shown when the user quits the app while remote devices are connected through remote access" use_name_for_id="true">
        {COUNT, plural,
          =1 {# device is connected through remote access. Quitting disconnects it.}
          other {# devices are connected through remote access. Quitting disconnects them.}}
      </message>
      <!-- Windows taskbar Jump List "Tasks" (right-click the taskbar icon) -->
      <message name="IDS_NEXUS_JUMPLIST_NEW_BROWSER_WINDOW" desc="Taskbar Jump List task that opens a new regular browser window" use_name_for_id="true">
        New browser window
      </message>
      <!-- Uninstall confirmation dialog (chrome.exe uninstall_view.cc) -->
      <message name="IDS_VELLOC_UNINSTALL_DELETE_ALL_DATA" desc="Checkbox in the uninstall confirmation dialog, unchecked by default. Ticking it deletes the browser profile (the cache, history and every other browser setting) and the product's own data directory ~/.velloc (sessions, settings, plugins, skills). Leaving it unticked uninstalls the program and keeps all data. Keep the path exactly as written." use_name_for_id="true">
        Also delete all data (cache + <ph name="DATA_DIR">~/.velloc<ex>~/.velloc</ex></ph>)
      </message>
      <message name="IDS_NEXUS_GUEST_RECOVERY_TITLE" desc="Title of the overlay shown in the agent panel when its runtime (the web app the panel loads) failed to start. PRODUCT_NAME is the product name." use_name_for_id="true">
        The <ph name="PRODUCT_NAME">$1<ex>Velloc</ex></ph> runtime didn’t load
      </message>
      <message name="IDS_NEXUS_GUEST_RECOVERY_BODY" desc="Body of the overlay shown in the agent panel when its runtime failed to start while the computer is online." use_name_for_id="true">
        The panel could not start its runtime. This usually means the configured runtime source is unreachable, or does not serve the version this build requires.
      </message>
      <message name="IDS_NEXUS_GUEST_RECOVERY_URL_LABEL" desc="Label before the web address the agent panel tried to load its runtime from, on the runtime-failed overlay. Followed by a colon and the address." use_name_for_id="true">
        Tried
      </message>
      <message name="IDS_NEXUS_GUEST_RECOVERY_RESET" desc="Button on the runtime-failed overlay: forget a custom runtime address, go back to the built-in one, and restart the app." use_name_for_id="true">
        Restore default runtime
      </message>
      <message name="IDS_NEXUS_GUEST_RECOVERY_RETRY" desc="Button on the runtime-failed overlay (also when offline): try loading the runtime again." use_name_for_id="true">
        Try again
      </message>
      <message name="IDS_NEXUS_GUEST_OFFLINE_TITLE" desc="Title of the overlay shown in the agent panel when its runtime could not load because the computer has no internet connection." use_name_for_id="true">
        You’re offline
      </message>
      <message name="IDS_NEXUS_GUEST_OFFLINE_BODY" desc="Body of the offline overlay in the agent panel. The panel retries by itself when the connection comes back. PRODUCT_NAME is the product name." use_name_for_id="true">
        <ph name="PRODUCT_NAME">$1<ex>Velloc</ex></ph> needs an internet connection to load. It will try again as soon as you’re back online.
      </message>
    </messages>
  </release>
</grit>
