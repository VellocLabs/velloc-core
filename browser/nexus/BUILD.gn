import("//build/config/chrome_build.gni")
import("//testing/test.gni")

assert(enable_custom_browser)

# =============================================================================
# Tool declaration codegen
#
# Reads `tools/declarations/<category>/<name>.tool.json` files and emits
# `$target_gen_dir/tools/<name>.gen.h` headers. Each header declares a
# typed input struct + abstract base class for the corresponding tool.
# Implementations inherit the base class and override `Run<Name>`.
#
# Phase 1 of the declarative tool-definition migration. Only one
# declaration today (`screenshot`); when Phase 3 splits browser_actions
# the inputs/outputs lists below grow correspondingly. See plan
# `giggly-watching-pie.md` for the migration path.
#
# To keep deps tracking precise, both `inputs` (files that influence
# the output) and `outputs` (files emitted) must be enumerated. A
# `*.tool.json` glob would miss new files and break incremental builds.
# =============================================================================
action("nexus_tools_codegen") {
  script = "codegen/generate.py"

  inputs = [
    # The codegen script itself — re-run when this changes.
    "codegen/tool_schema.json",
    "codegen/skill_schema.json",

    # Skill declarations — currently used only for editor validation +
    # codegen-side malformed-shape rejection. Phase 5+ runtime gating
    # will read these to decide which tools to omit from tools[] until
    # Skill('<name>') activates the bucket.
    "tools/declarations/skills/browser.skill.json",

    # Phase 13.2 / 13.7: cross-cutting native-tool prose for the
    # `{{system-prompt-tools}}` placeholder in
    # `nexus_web/public/system_prompts/*.md`. One Markdown file at the
    # top of `tools/declarations/` is the source of truth; codegen
    # reads it verbatim into `system_prompt_tools.gen.h` (a single
    # constexpr string the renderer returns as-is).
    "tools/declarations/system-prompt-tools.md",

    # Phase 13.4: catalog-frame manifest for the `{{TOOL_CATALOG}}`
    # placeholder — group ordering, the "## Browser tools" / "##
    # File and shell tools" headers, and `@file:` references to the
    # prose .md files below. Codegen emits `tool_catalog_frame.gen.h`
    # with constexpr string_views the renderer references, AND seeds
    # `_BROWSER_TOOL_GROUP_ORDER` so the per-tool prompt-entries
    # table sorts in the canonical group order defined here.
    "tools/declarations/tool-catalog-frame.json",

    # Phase 13.7 / 13.8 / 13.9: prose blocks for the catalog-frame
    # manifest above. Each .md is loaded by the codegen's `@file:`
    # resolver and embedded as a constexpr string in
    # `tool_catalog_frame.gen.h`. Listed individually so GN re-runs
    # codegen when any block changes.
    #
    # Phase 13.9 flattened all five sections to single-file form: the
    # browser-tools .md lives live in
    # `tool-catalog-frame/`. Each .md carries its own "## ..." header
    # and (for browser / file-shell) the per-tool bullet lines that
    # used to be aggregated from each .tool.json's `prompt` block.
    "tools/declarations/tool-catalog-frame/browser-tools.md",
    "tools/declarations/tool-catalog-frame/file-shell-tools.md",
    "tools/declarations/tool-catalog-frame/task-tracking.md",
    "tools/declarations/tool-catalog-frame/skills.md",
    "tools/declarations/tool-catalog-frame/parallelism.md",

    # Every *.tool.json declaration. Add a line per new file.
    # Phase 13: collapsed catalog — was 24 tools, now 20. Cuts:
    #   - wait/forward removed (low utility); create_tab merged into navigate
    #     (new_tab boolean); media_play/pause/seek merged into media_control
    #     (action discriminator); BrowserFillForm added for batch form fills.
    "tools/declarations/browser_tool/activate_tab.tool.json",
    "tools/declarations/browser_tool/back.tool.json",
    "tools/declarations/browser_tool/click.tool.json",
    "tools/declarations/browser_tool/close_tab.tool.json",
    "tools/declarations/browser_tool/done.tool.json",
    "tools/declarations/browser_tool/download.tool.json",
    "tools/declarations/browser_tool/drag_and_drop.tool.json",
    "tools/declarations/browser_tool/fill_form.tool.json",
    "tools/declarations/browser_tool/find_text.tool.json",
    "tools/declarations/browser_tool/hover.tool.json",
    "tools/declarations/browser_tool/input.tool.json",
    "tools/declarations/browser_tool/media_control.tool.json",
    "tools/declarations/browser_tool/media_state.tool.json",
    "tools/declarations/browser_tool/navigate.tool.json",
    "tools/declarations/browser_tool/read_element.tool.json",
    "tools/declarations/browser_tool/read_page.tool.json",
    "tools/declarations/browser_tool/screenshot.tool.json",
    "tools/declarations/browser_tool/scroll.tool.json",
    "tools/declarations/browser_tool/scroll_to.tool.json",
    "tools/declarations/browser_tool/search.tool.json",
    "tools/declarations/browser_tool/select.tool.json",
    "tools/declarations/browser_tool/upload.tool.json",

    # file_tool category — Claude-Code-style local-filesystem tools.
    # All run on base::ThreadPool (runtime.thread = "thread_pool")
    # because they do blocking disk I/O.
    "tools/declarations/file_tool/edit.tool.json",
    "tools/declarations/file_tool/glob.tool.json",
    "tools/declarations/file_tool/read.tool.json",
    "tools/declarations/file_tool/write.tool.json",

    # process_tool category — UI-thread tools that fire async mojo
    # calls into NexusShellService. Bash runs arbitrary host shell
    # commands; Grep shells out to ripgrep.
    "tools/declarations/process_tool/bash.tool.json",
    "tools/declarations/process_tool/grep.tool.json",
    "tools/declarations/process_tool/power_shell.tool.json",

    # Bridge-API declarations (Phase 10c). Each *.api.json names a
    # single wire action under one of the categories below. Codegen
    # produces a per-category abstract base (e.g. `FsApiBase`,
    # `LlmApiBase`) whose ctor calls Register(...) for every action,
    # so the hand-written adapter only declares Handle*() overrides.
    # Adding a new action = drop a *.api.json next to its peers and
    # add it to the inputs/outputs lists below.
    "codegen/api_schema.json",

    # fs category — 13 actions, all proxied through NexusFsHost.
    "api/declarations/fs/appendFile.api.json",
    "api/declarations/fs/cwd.api.json",
    "api/declarations/fs/exists.api.json",
    "api/declarations/fs/mkdir.api.json",
    "api/declarations/fs/readFile.api.json",
    "api/declarations/fs/readFileBytes.api.json",
    "api/declarations/fs/readRange.api.json",
    "api/declarations/fs/readdir.api.json",
    "api/declarations/fs/realpath.api.json",
    "api/declarations/fs/rm.api.json",
    "api/declarations/fs/stat.api.json",
    "api/declarations/fs/systemInfo.api.json",
    "api/declarations/fs/unlink.api.json",
    "api/declarations/fs/writeFile.api.json",

    # llm category — 7 actions, proxied through NexusLlmHost / LlmBroker.
    # Phase 12f moved `publishStatus` out to the new `session` category.
    "api/declarations/llm/call.api.json",
    "api/declarations/llm/catalog.api.json",
    "api/declarations/llm/publishCatalog.api.json",
    "api/declarations/llm/setDefaultSelection.api.json",
    "api/declarations/llm/streamCancel.api.json",
    "api/declarations/llm/streamRead.api.json",
    "api/declarations/llm/streamStart.api.json",

    # network category — V1 of the WebFetch tool. General-purpose HTTP
    # GET over the Chromium net stack, exposed to TS-side tools that
    # need to fetch URLs without renderer-CORS gating. Wraps
    # `network::SimpleURLLoader` in `NexusNetworkHost`.
    "api/declarations/network/httpGet.api.json",

    # session category — 3 actions (Phase 12f). Dedicated capability
    # for SessionStatus + LLM-session lifecycle. `publishStatus` and
    # `onStop` (renamed from `browser.endSession`) plus
    # `setAgentLoopSettings` (renamed from `browser.setAgentLoopSettings`).
    "api/declarations/session/onStop.api.json",
    "api/declarations/session/publishStatus.api.json",
    "api/declarations/session/setAgentLoopSettings.api.json",

    # ui category — 8 actions; settings shortcut + boot-state events
    # + opaque pass-through broadcasts + open-url. All run on UI (the
    # bridge's home thread).
    "api/declarations/ui/broadcastCurrentSessionState.api.json",
    "api/declarations/ui/broadcastSessionsSummary.api.json",
    "api/declarations/ui/dismissBootWelcome.api.json",
    "api/declarations/ui/getBootTimings.api.json",
    "api/declarations/ui/getProviderMissingPrompt.api.json",
    "api/declarations/ui/openNexusSettings.api.json",
    "api/declarations/ui/openUrl.api.json",
    "api/declarations/ui/showMainContents.api.json",

    # catalog category — 3 actions; replaces the bootstrap manifest's
    # hostedTools field with a lazy-pull API and moves prompt-section
    # rendering (was getUsingYourToolsSection in TS) to C++ as the
    # single source of truth for tool-name knowledge.
    "api/declarations/catalog/listHostedTools.api.json",
    "api/declarations/catalog/listPromptSections.api.json",
    "api/declarations/catalog/renderPromptSection.api.json",
  ]

  outputs = [
    # Per-tool: one *.gen.h per *.tool.json above, in the same order.
    "$target_gen_dir/tools/activate_tab.gen.h",
    "$target_gen_dir/tools/back.gen.h",
    "$target_gen_dir/tools/click.gen.h",
    "$target_gen_dir/tools/close_tab.gen.h",
    "$target_gen_dir/tools/done.gen.h",
    "$target_gen_dir/tools/drag_and_drop.gen.h",
    "$target_gen_dir/tools/fill_form.gen.h",
    "$target_gen_dir/tools/find_text.gen.h",
    "$target_gen_dir/tools/hover.gen.h",
    "$target_gen_dir/tools/input.gen.h",
    "$target_gen_dir/tools/media_control.gen.h",
    "$target_gen_dir/tools/media_state.gen.h",
    "$target_gen_dir/tools/navigate.gen.h",
    "$target_gen_dir/tools/read_element.gen.h",
    "$target_gen_dir/tools/read_page.gen.h",
    "$target_gen_dir/tools/screenshot.gen.h",
    "$target_gen_dir/tools/scroll.gen.h",
    "$target_gen_dir/tools/scroll_to.gen.h",
    "$target_gen_dir/tools/search.gen.h",
    "$target_gen_dir/tools/select.gen.h",

    # file_tool category — sorted by tool name within the category to
    # match generate.py's sorted-by-name emission order.
    "$target_gen_dir/tools/edit.gen.h",
    "$target_gen_dir/tools/glob.gen.h",
    "$target_gen_dir/tools/read.gen.h",
    "$target_gen_dir/tools/write.gen.h",

    # process_tool category — UI-thread tools that fire async mojo
    # calls into NexusShellService.
    "$target_gen_dir/tools/bash.gen.h",
    "$target_gen_dir/tools/grep.gen.h",

    # Bridge-API codegen (Phase 10c). One <category>_api.gen.{h,cc}
    # pair per category. The .h holds the abstract base class with
    # Handle*() pure virtuals; the .cc holds the ctor body whose
    # Register() calls bind action names to those virtuals. The .h
    # is consumed by the matching adapter header
    # (api/<cat>/nexus_<cat>_bridge_adapter.h); the .cc is compiled
    # into the `bridge` source_set so its FsApiBase / LlmApiBase
    # ctor symbols satisfy the linker.
    "$target_gen_dir/api/fs/fs_api.gen.h",
    "$target_gen_dir/api/fs/fs_api.gen.cc",
    "$target_gen_dir/api/llm/llm_api.gen.h",
    "$target_gen_dir/api/llm/llm_api.gen.cc",
    "$target_gen_dir/api/network/network_api.gen.h",
    "$target_gen_dir/api/network/network_api.gen.cc",
    "$target_gen_dir/api/ui/ui_api.gen.h",
    "$target_gen_dir/api/ui/ui_api.gen.cc",
    "$target_gen_dir/api/catalog/catalog_api.gen.h",
    "$target_gen_dir/api/catalog/catalog_api.gen.cc",
    "$target_gen_dir/api/session/session_api.gen.h",
    "$target_gen_dir/api/session/session_api.gen.cc",

    # Per-category aggregate: one *.gen.h per UNIQUE folder under
    # declarations/. Holds the abstract base class (e.g.
    # `BrowserToolBase`) whose pure virtuals aggregate every tool in
    # the category. The implementation class inherits this base.
    # Add a line whenever a new declarations/<category>/ folder is
    # introduced.
    "$target_gen_dir/tools/browser_tool.gen.h",
    "$target_gen_dir/tools/file_tool.gen.h",
    "$target_gen_dir/tools/process_tool.gen.h",

    # Combined registry: one .gen.h declaring AllSchemas() +
    # PopulateRegistry(), one .gen.cc defining them. The .gen.cc is the
    # only source-of-record of the combined registry plumbing; it gets
    # compiled into the `bridge` source_set below.
    "$target_gen_dir/tools/nexus_tools_registry.gen.h",
    "$target_gen_dir/tools/nexus_tools_registry.gen.cc",

    # Phase 13.2: rendered cross-cutting native-tool prose for the
    # `{{system-prompt-tools}}` placeholder. Source .md at
    # tools/declarations/system-prompt-tools.md. Consumed by
    # api/catalog/prompt_section_renderer.cc.
    "$target_gen_dir/tools/system_prompt_tools.gen.h",

    # Phase 13.4 / 13.8 / 13.9: rendered catalog-frame prose for the
    # `{{TOOL_CATALOG}}` placeholder. Source manifest at
    # tools/declarations/tool-catalog-frame.json (references one .md
    # per section). Consumed by api/catalog/prompt_section_renderer.cc
    # via the constexpr string_views `kBrowserToolsContent`,
    # `kFileShellToolsContent`, `kTaskTrackingContent`, `kSkillsContent`,
    # `kParallelismContent`, plus the wire-name arrays
    # `kBrowserToolWireNames` / `kFileShellToolWireNames` (used to gate
    # whether each section is emitted).
    "$target_gen_dir/tools/tool_catalog_frame.gen.h",
  ]

  args = [
    "--declarations-dir",
    rebase_path("tools/declarations", root_build_dir),
    "--output-dir",
    rebase_path("$target_gen_dir/tools", root_build_dir),
    # Bridge-API codegen (Phase 10c). Optional flags; when present, the
    # script ALSO emits one <category>_api.gen.{h,cc} per category under
    # api/declarations/<category>/.
    "--api-declarations-dir",
    rebase_path("api/declarations", root_build_dir),
    "--api-output-dir",
    rebase_path("$target_gen_dir/api", root_build_dir),
  ]
}

source_set("fs") {
  sources = [
    "api/fs/nexus_fs_host.cc",
    "api/fs/nexus_fs_host.h",
  ]

  deps = [
    "//base",
    "//mojo/public/cpp/base",
  ]
}

# Minimal source_set holding just `ToolParameter` / `ToolSchema` / the
# JsonSchemaKind enum. Extracted out of `bridge` so the `unit_tests_lite`
# target can link these symbols (needed by the codegen smoke test in
# codegen/) without dragging in the rest of the bridge — which
# pulls in //chrome/browser, content::, mojom bindings, and the actor
# stack. Kept header-only-clean so the extraction stays cheap.
source_set("tool_schema") {
  sources = [
    "tools/nexus_tool_schema.cc",
    "tools/nexus_tool_schema.h",
  ]

  public_deps = [ "//base" ]
}

source_set("bridge") {
  sources = [
    "api/catalog/nexus_catalog_bridge_adapter.cc",
    "api/catalog/nexus_catalog_bridge_adapter.h",
    "api/catalog/prompt_section_renderer.cc",
    "api/catalog/prompt_section_renderer.h",
    "api/fs/nexus_fs_bridge_adapter.cc",
    "api/fs/nexus_fs_bridge_adapter.h",
    "api/llm/nexus_llm_bridge_adapter.cc",
    "api/llm/nexus_llm_bridge_adapter.h",
    "api/llm/nexus_llm_bridge_support.cc",
    "api/llm/nexus_llm_bridge_support.h",
    "api/network/nexus_network_bridge_adapter.cc",
    "api/network/nexus_network_bridge_adapter.h",
    "api/network/nexus_network_host.cc",
    "api/network/nexus_network_host.h",
    "api/session/nexus_session_bridge_adapter.cc",
    "api/session/nexus_session_bridge_adapter.h",
    "bridge_response_callback.cc",
    "bridge_response_callback.h",
    "nexus_bridge_capability_handler.cc",
    "nexus_bridge_capability_handler.h",
    "nexus_bridge_bootstrap_host.cc",
    "nexus_bridge_bootstrap_host.h",
    "nexus_bridge_port_service.cc",
    "nexus_bridge_port_service.h",
    "nexus_bridge_response_delegate.h",
    "nexus_bridge_support.cc",
    "nexus_bridge_support.h",
    "nexus_host_manifest.cc",
    "nexus_host_manifest.h",
    "nexus_message_port_endpoint.cc",
    "nexus_message_port_endpoint.h",
    "tools/browser_tool/browser_tool.cc",
    "tools/browser_tool/browser_tool.h",
    "tools/browser_tool/browser_tool_actions.cc",
    "tools/browser_tool/browser_tool_internal.cc",
    "tools/browser_tool/browser_tool_internal.h",
    "tools/browser_tool/download_capture.cc",
    "tools/browser_tool/download_capture.h",
    "tools/browser_tool/node_registry.cc",
    "tools/browser_tool/node_registry.h",
    "tools/file_tool/file_tool.cc",
    "tools/file_tool/file_tool.h",
    "tools/process_tool/nexus_shell_service_launcher.cc",
    "tools/process_tool/nexus_shell_service_launcher.h",
    "tools/process_tool/process_tool.cc",
    "tools/process_tool/process_tool.h",
    "tools/nexus_tool_callback.cc",
    "tools/nexus_tool_callback.h",
    "tools/nexus_tool_macros.h",
    "tools/nexus_tool_registry.cc",
    "tools/nexus_tool_registry.h",
    "tools/nexus_tool_signature.cc",
    "tools/nexus_tool_signature.h",
    "tools/tool_base.cc",
    "tools/tool_base.h",
    "tools/tool_catalog.cc",
    "tools/tool_catalog.h",
    "tools/tool_session.cc",
    "tools/tool_session.h",
    "tools/tools_adapter.cc",
    "tools/tools_adapter.h",
    "api/ui/nexus_ui_bridge_adapter.cc",
    "api/ui/nexus_ui_bridge_adapter.h",
    "ui/nexus_ui_broadcast.cc",
    "ui/nexus_ui_broadcast.h",

    # Codegen output. Compiled into bridge so generated::AllSchemas()
    # and the per-tool inline schema builders / extractors are linked
    # into anything that consumes bridge. Phase 3 will start calling
    # AllSchemas() from ToolCatalog::Get(); for now the symbol is
    # defined-but-unused (linker keeps it; harmless).
    "$target_gen_dir/tools/nexus_tools_registry.gen.cc",

    # Bridge-API codegen (Phase 10c). The per-category .gen.cc holds
    # `FsApiBase`/`LlmApiBase`'s ctor body — the Register() block that
    # used to live in each adapter constructor. Compiled into bridge
    # because the adapters (also in bridge) inherit those bases and
    # need their ctors/dtors to link.
    "$target_gen_dir/api/fs/fs_api.gen.cc",
    "$target_gen_dir/api/llm/llm_api.gen.cc",
    "$target_gen_dir/api/network/network_api.gen.cc",
    "$target_gen_dir/api/ui/ui_api.gen.cc",
    "$target_gen_dir/api/catalog/catalog_api.gen.cc",
    "$target_gen_dir/api/session/session_api.gen.cc",
  ]

  public_deps = [
    # nexus_tool_schema's types appear in bridge's public headers
    # (tool_base.h, tool_catalog.h, …) so consumers of bridge transitively
    # need access to them. Promote to public_deps to keep that link.
    ":tool_schema",
  ]

  deps = [
    ":fs",
    # Run the tool-declaration codegen before compiling. Phase 1 only
    # produces `screenshot.gen.h` (and nothing #includes it yet); the
    # dep ensures the codegen action runs as part of every bridge
    # build so we catch breakage early. Phase 2 onwards will start
    # consuming the generated headers from C++ sources.
    ":nexus_tools_codegen",
    # Per-session tab grouping. BrowserTool tags + groups freshly
    # created tabs; ResolveTabIdOrReject + BuildObservationDict filter
    # by the per-tab session tag.
    ":session_tab_management",
    # BrowserUpload arms NexusPendingUpload before clicking a file input;
    # the chooser is answered by the hook in Browser::RunFileChooser.
    ":file_chooser_interceptor",
    # Reads the `separate window` tab-hosting pref so RunCreateTabAction can
    # target/create the dedicated agent window.
    ":browser_tools_config",
    "mojom",
    "//base",
    "//chrome/browser/actor",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/common:mojo_bindings",
    "//components/optimization_guide/proto:optimization_guide_proto",
    # NexusSessionBridgeAdapter observes `nexus.agent_config` via a
    # PrefChangeRegistrar to push live settings updates to the guest.
    "//components/prefs",
    # BrowserDownload (download_capture.{h,cc}) observes the profile's
    # download::DownloadItem / DownloadUrlParameters via DownloadManager.
    "//components/download/public/common:public",
    # BrowserTool's per-session group bookkeeping uses
    # tab_groups::TabGroupId / TabGroupColorId / TabGroupVisualData and
    # tabs::TabHandle / tabs::TabInterface directly. (Pre-refactor these
    # were pulled in through the now-removed registry source_set's
    # public deps.)
    "//components/tab_groups",
    "//components/tabs:public",
    "//content/public/browser",
    "//crypto",
    "//custom_browser/browser/nexus/api/llm:broker",
    "//custom_browser/browser/nexus/api/llm:pref_names",
    "//custom_browser/browser/nexus/api/llm:webui_host",
    "//mojo/public/cpp/base",
    "//mojo/public/cpp/bindings",
    # V1 WebFetch / network.httpGet — pulls in
    # `network::SimpleURLLoader`, `network::SharedURLLoaderFactory`,
    # `network::ResourceRequest`, and the URLResponseHead mojom.
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//net/traffic_annotation",
    "//third_party/blink/public/common",
    # FileTool::RunGlobOnThreadPool compiles glob patterns to RE2 and
    # uses re2::RE2::FullMatch for path filtering.
    "//third_party/re2",
    "//url",
  ]
}

