  <translation id="IDS_NEXUS_PERMISSION_FILES_TITLE">Accès au système de fichiers</translation>
  <translation id="IDS_NEXUS_PERMISSION_FILES_BODY">Cet agent souhaite lire et écrire des fichiers sur votre ordinateur.</translation>
  <translation id="IDS_NEXUS_PERMISSION_CLIPBOARD_TITLE">Accès au presse-papiers</translation>
  <translation id="IDS_NEXUS_PERMISSION_CLIPBOARD_BODY">Cet agent souhaite accéder à votre presse-papiers.</translation>
  <translation id="IDS_NEXUS_PERMISSION_BROWSER_DATA_TITLE">Accès aux données du navigateur</translation>
  <translation id="IDS_NEXUS_PERMISSION_BROWSER_DATA_BODY">Cet agent souhaite accéder à vos favoris, votre historique et vos téléchargements.</translation>
  <translation id="IDS_NEXUS_PERMISSION_NOTIFICATIONS_TITLE">Notifications</translation>
  <translation id="IDS_NEXUS_PERMISSION_NOTIFICATIONS_BODY">Cet agent souhaite vous envoyer des notifications.</translation>
  <translation id="IDS_NEXUS_PERMISSION_ALLOW">Autoriser</translation>
  <translation id="IDS_NEXUS_PERMISSION_DENY">Refuser</translation>
  <translation id="IDS_NEXUS_SETUP_PROVIDER_TITLE">Configurez votre fournisseur d'IA</translation>
  <translation id="IDS_NEXUS_SETUP_PROVIDER_BODY">Choisissez un fournisseur d'IA et saisissez vos identifiants pour commencer.</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_1">Cette fonctionnalité exécute <ph name="PRODUCT_NAME"/> directement dans le navigateur, en connectant des applications comme WhatsApp, Telegram, Discord et iMessage à des assistants de codage IA.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_DESCRIPTION"><ph name="PRODUCT_NAME"/> peut utiliser de nombreux fournisseurs de LLM. Choisissez un fournisseur, authentifiez-vous, puis définissez le modèle par défaut.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_ROW_SUBLABEL"><ph name="PRODUCT_NAME"/> peut utiliser de nombreux fournisseurs de LLM. Choisissez un fournisseur, authentifiez-vous, puis définissez le modèle par défaut.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONNECTION_DESCRIPTION">Choisissez le service auquel <ph name="PRODUCT_NAME"/> doit se connecter et vérifiez la connexion.</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_ROW_SUBLABEL">Configurez l'URL de l'application Web utilisée par <ph name="PRODUCT_LONG_NAME"/>.</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DESCRIPTION">Définissez une URL personnalisée pour l'application Web <ph name="PRODUCT_NAME"/>. Laissez ce champ vide pour utiliser l'expérience par défaut.</translation>
  <translation id="IDS_NEXUS_SETTINGS_OLLAMA_NOTE">Aucune clé API n'est requise. <ph name="PRODUCT_LONG_NAME"/> charge les modèles depuis le serveur Ollama configuré.</translation>
  <translation id="IDS_NEXUS_SETTINGS_NO_PROVIDER_STATE">Les informations sur le fournisseur <ph name="PRODUCT_LONG_NAME"/> ne sont pas disponibles pour ce profil.</translation>
  <translation id="IDS_NEXUS_SETTINGS_SELECT_PROVIDER">Sélectionnez un fournisseur</translation>
