}

# Session types (header-only for now).
source_set("session_types") {
  sources = [ "session/session_types.h" ]

  deps = [
    "//base",
    "//url",
  ]
}

# Settings WebUI handler for chrome://settings/nexus (T026).
source_set("nexus_settings_handler") {
  sources = [
    "settings/nexus_settings_handler.cc",
    "settings/nexus_settings_handler.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/webui/settings",
    "//content/public/browser",
    "//custom_browser/browser/nexus/llm",
    "//custom_browser/browser/nexus/llm:webui_host",
  ]
}

# Lightweight tests that only need base + prefs + gtest. Safe to put in a
# small standalone test binary — no TestingProfile / BrowserTaskEnvironment
# transitively pull in all of //chrome/browser.
source_set("unit_tests_lite") {
  testonly = true

  sources = [
    "domain/domain_sandbox_manager_unittest.cc",
    "llm/llm_line_splitter_unittest.cc",
    "llm/llm_provider_factory_unittest.cc",
    "llm/llm_text_helpers_unittest.cc",
    "llm/llm_types_unittest.cc",
    "llm/provider_config_unittest.cc",
    "permissions/nexus_permission_manager_unittest.cc",
  ]

  deps = [
    ":domain",
    ":permissions",
    "//base/test:test_support",
    "//components/prefs",
    "//components/prefs:test_support",
    "//custom_browser/browser/nexus/llm:line_splitter",
    "//custom_browser/browser/nexus/llm:pref_names",
    "//custom_browser/browser/nexus/llm:provider",
    "//custom_browser/browser/nexus/llm:provider_config",
    "//custom_browser/browser/nexus/llm:provider_factory",
    "//custom_browser/browser/nexus/llm:text_helpers",
    "//custom_browser/browser/nexus/llm:types",
    "//services/network/public/cpp",
    "//testing/gtest",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "fs/nexus_fs_host_unittest.cc",
    "llm/nexus_llm_bridge_support_unittest.cc",
    "nexus_guest_config_unittest.cc",
    "tools/nexus_tool_schema_unittest.cc",
    "tools/nexus_tool_signature_unittest.cc",
    "tools/node_registry_unittest.cc",
    "tools/tool_base_unittest.cc",
    "tools/tool_session_unittest.cc",
  ]

  deps = [
    ":bridge",
    ":fs",
    ":guest_config",
    ":unit_tests_lite",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//components/prefs",
    "//components/sync_preferences:test_support",
    "//custom_browser/browser/nexus/llm:pref_registration",
    "//testing/gtest",
  ]
}

# Standalone test binary for the lightweight nexus unit tests. Run with:
#   autoninja -C out/Debug custom_browser_nexus_unittests
#   out/Debug/custom_browser_nexus_unittests
test("custom_browser_nexus_unittests") {
  deps = [
    ":unit_tests_lite",
    "//base/test:run_all_unittests",
    "//services/network/public/mojom",
    "//testing/gtest",
  ]
}
