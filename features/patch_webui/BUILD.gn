import("//testing/test.gni")

source_set("patch_resources") {
  sources = [
    "patch_resources.cc",
    "patch_resources.h",
  ]

  deps = [
    "//content/public/browser",
    "//custom_browser/common",
    "//custom_browser/resources:custom_browser_strings",
    "//custom_browser/resources/patch_webui:resources",
  ]
}

source_set("feature") {
  sources = [
    "extensions_hooks.cc",
    "extensions_hooks.h",
    "navigation_hooks.cc",
    "navigation_hooks.h",
    "nexus_bootstrap_hooks.cc",
    "nexus_bootstrap_hooks.h",
    "ntp_hooks.cc",
    "ntp_hooks.h",
    "register_hooks.cc",
    "register_hooks.h",
    "settings_hooks.cc",
    "settings_hooks.h",
  ]

  deps = [
    ":patch_resources",
    "//base",
    "//chrome/app:generated_resources_grit",
    "//chrome/app/theme:chrome_unscaled_resources_grit",
    "//chrome/browser:browser_process",
    "//chrome/browser/search",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui",
    "//chrome/common:channel_info",
    "//chrome/common:url_constants",
    "//components/strings:components_strings",
    "//components/version_info",
    "//content/public/browser",
    "//custom_browser/browser/nexus:bridge",
    "//custom_browser/browser/nexus:guest_config",
    "//custom_browser/browser/nexus/api/llm",
    "//custom_browser/browser/nexus/api/llm:broker",
    "//custom_browser/browser/nexus/api/llm:oauth",
    "//custom_browser/browser/nexus/mojom",
    "//net",
    "//custom_browser/chromium_hooks:hook_api",
    "//custom_browser/chromium_hooks:hook_core",
    "//custom_browser/common",
    "//custom_browser/resources:custom_browser_strings",
    "//custom_browser/resources/patch_webui:resources",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "patch_resources_unittest.cc" ]

  deps = [
    ":patch_resources",
    "//testing/gtest",
  ]
}

# Standalone test binary for the patch_webui unit tests. Run with:
#   autoninja -C out/Debug custom_browser_patch_webui_unittests
#   out/Debug/custom_browser_patch_webui_unittests
test("custom_browser_patch_webui_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
    "//testing/gtest",
  ]
}
