import("//build/config/chrome_build.gni")
import("//testing/test.gni")

assert(enable_custom_browser)

declare_args() {
  # Directory of the nexus_web checkout whose bridge interface version the
  # ninja-time gate (`:check_interface_version`) verifies against
  # nexus_interface_version.h. Empty = the script derives the sibling
  # checkout from the monorepo layout (<root>/nexus_web).
  nexus_web_dir = ""

  # Escape hatch for builds without a nexus_web checkout (isolated CI):
  # the gate then stamps with a warning instead of verifying the pairing.
  skip_nexus_interface_version_check = false
}

# Bridge interface version gate (G-3): fails the build when nexus_web's
# generated interfaceVersion.gen.ts declares a different number than
# NEXUS_INTERFACE_VERSION in //custom_browser/VERSION.
action("check_interface_version") {
  script = "scripts/check_interface_version.py"

  inputs = [ "//custom_browser/VERSION" ]

  _stamp = "$target_gen_dir/interface_version_check.stamp"
  outputs = [ _stamp ]
  depfile = "$target_gen_dir/interface_version_check.d"

  args = [
    "--version-file",
    rebase_path("//custom_browser/VERSION", root_build_dir),
    "--stamp",
    rebase_path(_stamp, root_build_dir),
    "--depfile",
    rebase_path(depfile, root_build_dir),
  ]
  if (nexus_web_dir != "") {
    args += [
      "--nexus-web-dir",
      rebase_path(nexus_web_dir, root_build_dir),
    ]
  }
  if (skip_nexus_interface_version_check) {
    args += [ "--skip" ]
  }
}

source_set("interface_version") {
  sources = [ "nexus_interface_version.h" ]

  public_deps = [
    # Emits the generated nexus_interface_version.inc the header includes.
    "//custom_browser/common:generate_product_version",
  ]

  deps = [ ":check_interface_version" ]
}

