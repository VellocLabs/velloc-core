  <translation id="IDS_CUSTOM_BROWSER_BUILTIN_DETAILS_ENABLED">有効</translation>
  <translation id="IDS_CUSTOM_BROWSER_BUILTIN_DETAILS_DEFAULT">デフォルト</translation>
  <translation id="IDS_CUSTOM_BROWSER_BUILTIN_DETAILS_BACKGROUND_PAGE">バックグラウンドページ</translation>
  <translation id="IDS_CUSTOM_BROWSER_VALUE_ON">オン</translation>
  <translation id="IDS_CUSTOM_BROWSER_VALUE_OFF">オフ</translation>
  <translation id="IDS_CUSTOM_BROWSER_VALUE_YES">はい</translation>
