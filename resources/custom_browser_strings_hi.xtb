  <translation id="IDS_NEXUS_SETTINGS_BASE_URL_PLACEHOLDER">http://localhost:11434</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_0">ये सुविधाएँ AI का इस्तेमाल करती हैं, अभी शुरुआती विकास के दौर में हैं और हमेशा सही नतीजे नहीं देंगी।</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_1">यह सुविधा <ph name="PRODUCT_NAME"/> को सीधे ब्राउज़र में चलाती है और WhatsApp, Telegram, Discord तथा iMessage जैसे ऐप्लिकेशन को AI कोडिंग सहायकों से जोड़ती है।</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_2">यह आपके ब्राउज़र को एक ऐसी केंद्रीय जगह बना देती है, जहाँ आप बातचीत कर सकते हैं और ऑनलाइन आम तौर पर जो कुछ करते हैं, उसमें AI की मदद ले सकते हैं।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_DESCRIPTION"><ph name="PRODUCT_NAME"/> कई LLM प्रदाताओं के साथ काम कर सकता है। कोई प्रदाता चुनें, पुष्टि करें और फिर डिफ़ॉल्ट मॉडल तय करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_ROW_SUBLABEL"><ph name="PRODUCT_NAME"/> कई LLM प्रदाताओं के साथ काम कर सकता है। कोई प्रदाता चुनें, पुष्टि करें और फिर डिफ़ॉल्ट मॉडल तय करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONNECTION_DESCRIPTION">वह सेवा चुनें जिससे <ph name="PRODUCT_NAME"/> को जुड़ना चाहिए, और कनेक्शन की पुष्टि करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_ROW_SUBLABEL"><ph name="PRODUCT_LONG_NAME"/> जिस वेब ऐप्लिकेशन URL का इस्तेमाल करता है, उसे सेट करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DESCRIPTION">अपनी पसंद का <ph name="PRODUCT_NAME"/> वेब ऐप्लिकेशन URL सेट करें। डिफ़ॉल्ट अनुभव के लिए इसे खाली छोड़ दें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_OLLAMA_NOTE">किसी API कुंजी की ज़रूरत नहीं है। <ph name="PRODUCT_LONG_NAME"/> सेट किए गए Ollama सर्वर से मॉडल लोड करता है।</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_HINT">मौजूदा सहेजी गई कुंजी बनाए रखने के लिए API कुंजी खाली छोड़ दें।</translation>
