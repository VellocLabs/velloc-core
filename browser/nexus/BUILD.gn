# Remote access (remote-browser-client plan §8): the desktop's in-process
# relay. A default-OFF listener (net::HttpServer on a dedicated IO thread)
# that reverse-proxies the guest origin's immutable build entry and exposes
# `/rt`, so a remote browser on the LAN/VPN can join this desktop's runtime
# with scope <= control. Wire protocol is byte-identical to
# `nexus_web/scripts/dev_remote_relay.mjs` (plan §6.4).
#
# Layout, deliberately split for testability:
#   remote_access_router.{h,cc}   pure functions — path classification,
#     Host/Origin/token gates, header filtering. No sockets, no threads, no
#     Profile, so the whole routing table runs in `unit_tests_lite`.
#   NexusRemoteAccessListener     owns net::HttpServer on a dedicated
#     MessagePumpType::IO thread (threading model copied from
#     content/browser/devtools/devtools_http_handler.cc). Pure routing +
#     WebSocket pairing; never touches Profile.
#   NexusRemoteAccessService      profile-level singleton on the UI thread —
#     prefs, start/stop, and the reverse-proxy's outbound URLLoaders.
#
# There is NO `//net/server:http_server` target — `src/net/server/` has no
# BUILD.gn and the sources are compiled straight into `//net` under
# `enable_websockets`, so depending on `//net` is the whole cost.
source_set("remote_access") {
  sources = [
    "remote_access/nexus_remote_access_listener.cc",
    "remote_access/nexus_remote_access_listener.h",
    "remote_access/remote_access_router.cc",
    "remote_access/remote_access_router.h",
  ]

  deps = [
    "//base",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]

  # Deliberately NOT //chrome/browser/ui: the listener must not depend on the
  # UI layer (see the ui -> settings_handler -> bridge -> ui cycle documented
  # on `:mcp_host`, BUILD.gn above).
}

# The process-wide "is remote access up, and how many devices are connected"
