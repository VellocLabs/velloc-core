# so `:bridge` can depend on it without forming a cycle through
# //chrome/browser/ui -> :nexus_settings_handler -> :bridge. (It used to share
# the `mcp_host` target with the native MCP client, removed under interface 1
# the runtime runs MCP over shell.spawn + network.streamOpen.)
source_set("shell_launcher") {
  sources = [
    "tools/process_tool/nexus_shell_service_launcher.cc",
    "tools/process_tool/nexus_shell_service_launcher.h",
  ]

  public_deps = [
    # nexus_shell.mojom types appear in the launcher header.
    "mojom",
    "//base",
  ]

  deps = [
    # ServiceProcessHost::Launch for the utility process.
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]
}

