  <translation id="IDS_NEXUS_SETTINGS_VALIDATE_TITLE">वर्तमान कॉन्फ़िगरेशन सत्यापित करें</translation>
  <translation id="IDS_NEXUS_SETTINGS_VALIDATE_DESCRIPTION">वर्तमान प्रदाता सेटिंग्स सहेजें और चुने हुए मॉडल की जांच करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_READY">वर्तमान सेटिंग्स उपयोग के लिए तैयार हैं।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_SETUP_REQUIRED">इस प्रदाता के कनेक्ट होने से पहले अतिरिक्त सेटअप आवश्यक है।</translation>
  <translation id="IDS_NEXUS_SETTINGS_SAVING_PROVIDER">प्रदाता सेटिंग्स सहेजी जा रही हैं...</translation>
  <translation id="IDS_NEXUS_SETTINGS_UPDATE_FAILED">प्रदाता सेटिंग्स अपडेट नहीं हो सकीं।</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DEFAULT_TITLE">डिफ़ॉल्ट व्यवहार</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">खोज प्रदाता का लोगो दिखाएं</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">Chromium के साथ शुरू करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">एक मिनट में Chromium सेट करें: अपना डेटा आयात करें, लेआउट चुनें, और अपनी नई टैब को व्यवस्थित करें।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">चरण 1. अपनी चीज़ें लाएं</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">किसी अन्य ब्राउज़र से बुकमार्क, पासवर्ड और सेटिंग्स आयात करें—किसी खाते की आवश्यकता नहीं।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">आयात करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">चरण 2. अपना लेआउट चुनें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">वह टैब शैली चुनें जो आपके काम के तरीके से मेल खाती हो। आप कभी भी बदल सकते हैं।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">साइडबार टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">आपके टैब, एड्रेस बार और टूल एक लंबवत साइडबार में।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">कॉम्पैक्ट साइडबार</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">आइकन-पहले वाला साइडबार जो होवर करने पर विस्तृत होता है—छोटी स्क्रीन के लिए बढ़िया।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">शीर्ष टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">परिचित Chrome-शैली लेआउट के लिए शीर्ष पर क्लासिक टैब।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">कॉम्पैक्ट शीर्ष टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">एक पतला शीर्ष लेआउट जो सबसे महत्वपूर्ण चीज़—पेज—के लिए अधिक जगह छोड़ता है।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">लेआउट बदलाव तुरंत लागू होते हैं।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">लेआउट लागू करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">चरण 3. अपनी नई टैब को अनुकूलित करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">इसे साफ रखें, या खोज को सामने रखें।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">नई टैब पर खोज बॉक्स दिखाएं</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">खोज बॉक्स दिखाई दे रहा है</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">नई टैब बाधा-मुक्त रहती है</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">आपकी खोज, आपका रूप</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">यदि आप Google के अलावा कोई डिफ़ॉल्ट खोज चुनते हैं, तो Chromium नई टैब की ब्रांडिंग अपने-आप अपडेट कर देता है।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_TITLE">चरण 4. अंतर्निहित पावर टूल</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_DESCRIPTION">Chromium में वैकल्पिक अंतर्निहित एक्सटेंशन शामिल हैं। नियंत्रण आपके पास रहता है।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_TITLE">uBlock Origin</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_STATUS">डिफ़ॉल्ट रूप से सक्षम</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_DESCRIPTION">तेज़, साफ़ वेब के लिए कुशल सामग्री अवरोधन।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_TITLE">Tampermonkey (लीगेसी)</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_STATUS">डिफ़ॉल्ट रूप से बंद</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_DESCRIPTION">गहन साइट अनुकूलन के लिए उन्नत यूज़रस्क्रिप्ट प्रबंधक।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_MANAGE_BUTTON">एक्सटेंशन प्रबंधित करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_FOOTNOTE">कुछ अंतर्निहित टूल Chrome Web Store में उपलब्धता से भिन्न हो सकते हैं।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">चरण 5. आप तैयार हैं</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">बहुत बढ़िया। और आगे बढ़ना चाहते हैं? आगे और सुविधाएं देखें।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">नई टैब खोलें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">सेटिंग्स पर जाएं</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">एक्सटेंशन →</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_RECOMMENDED">अनुशंसित</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_MINIMAL">न्यूनतम</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_COMING_SOON">जल्द आ रहा है</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_AUTOMATIC">स्वचालित</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_ADVANCED">उन्नत</translation>
  <translation id="IDS_CUSTOM_BROWSER_VERSION_LINE">संस्करण <ph name="PRODUCT_VERSION"/> (<ph name="OFFICIAL_LABEL"/>)<ph name="VERSION_MODIFIER"/></translation>
  <translation id="IDS_CUSTOM_BROWSER_BASED_ON_CHROMIUM_LINE">Chromium <ph name="CHROMIUM_VERSION"/> पर आधारित</translation>
  <translation id="IDS_NEXUS_SETTINGS_TITLE"><ph name="PRODUCT_NAME"/></translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_PAGE_TITLE">मॉडल प्रदाता</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_LABEL">कस्टम <ph name="PRODUCT_NAME"/> वेब ऐप URL</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_PLACEHOLDER">https://your-app.example.com</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_1">यह सुविधा <ph name="PRODUCT_NAME"/> को सीधे ब्राउज़र में चलाती है, जो WhatsApp, Telegram, Discord और iMessage जैसे ऐप्स को AI कोडिंग असिस्टेंट से जोड़ती है।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_DESCRIPTION"><ph name="PRODUCT_NAME"/> कई LLM प्रदाताओं का उपयोग कर सकता है। एक प्रदाता चुनें, प्रमाणित करें, फिर डिफ़ॉल्ट मॉडल सेट करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_ROW_SUBLABEL"><ph name="PRODUCT_NAME"/> कई LLM प्रदाताओं का उपयोग कर सकता है। एक प्रदाता चुनें, प्रमाणित करें, फिर डिफ़ॉल्ट मॉडल सेट करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONNECTION_DESCRIPTION">वह सेवा चुनें जिससे <ph name="PRODUCT_NAME"/> को कनेक्ट होना चाहिए और कनेक्शन सत्यापित करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_ROW_SUBLABEL"><ph name="PRODUCT_LONG_NAME"/> द्वारा उपयोग किया जाने वाला वेब ऐप URL कॉन्फ़िगर करें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DESCRIPTION">कस्टम <ph name="PRODUCT_NAME"/> वेब ऐप URL सेट करें। डिफ़ॉल्ट अनुभव का उपयोग करने के लिए इसे खाली छोड़ दें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_OLLAMA_NOTE">किसी API कुंजी की आवश्यकता नहीं है। <ph name="PRODUCT_LONG_NAME"/> कॉन्फ़िगर किए गए Ollama सर्वर से मॉडल लोड करता है।</translation>
