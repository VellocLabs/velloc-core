source_set("guest_config") {
  sources = [
    "nexus_guest_config.cc",
    "nexus_guest_config.h",
  ]

  public_deps = [
    ":nexus_webui_config",
    "//base",
    "//chrome/browser/profiles:profile",
    "//content/public/common",
    "//custom_browser/browser/nexus/llm:pref_names",
    "//url",
  ]

  deps = [
    "//components/prefs",
    "//net",
  ]
