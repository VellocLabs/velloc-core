{
  "$schema": "../../../codegen/api_schema.json",
  "name": "glob",
  "description": "Host action behind the Glob tool. The model-facing definition (name, description, schema) lives in the runtime; this declares only the wire parameters.",
  "struct_name": "FilesGlob",
  "inputs": [
    {
      "name": "pattern",
      "type": "string",
      "required": true
    },
    {
      "name": "path",
      "type": "string",
      "required": false
    },
    {
      "name": "limit",
      "type": "integer",
      "required": false
    }
  ],
  "errors": [
    {
      "code": "invalid_args",
      "params": [
        "reason"
      ]
    },
    {
      "code": "glob_failed",
      "params": [
        "detail",
        "service_code"
      ]
    }
  ],
  "runtime": {
    "thread": "ui"
  }
}
