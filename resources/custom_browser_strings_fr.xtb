  <translation id="IDS_CUSTOM_BROWSER_BADGE_MINIMAL">Minimal</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_COMING_SOON">Bientôt disponible</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_AUTOMATIC">Automatique</translation>
