<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE translationbundle>
<translationbundle lang="hi">
  <translation id="IDS_CUSTOM_BROWSER_MODES_HEADER">लेआउट</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR">साइडबार टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR_DESCRIPTION">साइडबार पर वर्टिकल टैब।</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR">साइडबार टैब · कॉम्पैक्ट</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR_DESCRIPTION">साइडबार पर सिर्फ़ आइकॉन वाले वर्टिकल टैब।</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD">ऊपर टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD_DESCRIPTION">ऊपर की पट्टी पर हॉरिज़ॉन्टल टैब।</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD">ऊपर टैब · कॉम्पैक्ट</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD_DESCRIPTION">हॉरिज़ॉन्टल टैब, जो कर्सर ले जाने पर दिखते हैं।</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_NTP_SECTION_TITLE">नया टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_SEARCH">सर्च बॉक्स दिखाएँ</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">सर्च इंजन का लोगो दिखाएँ</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SEARCH_ENGINE">सर्च इंजन</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_BODY">अपने नए टैब के साथ शुरुआत करें। इसे अपने हिसाब से ढालने के सुझाव और शॉर्टकट।</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_ACTION">शुरुआती गाइड खोलें</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOADING">लोड हो रहा है…</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TITLE">शुरुआत करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BODY">यहाँ से शुरू करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">Chromium के साथ शुरुआत करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">Chromium को एक मिनट में सेट करें: अपना डेटा इंपोर्ट करें, लेआउट चुनें और नया टैब अपने हिसाब से ढालें।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">चरण 1. अपना सामान साथ लाएँ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">दूसरे ब्राउज़र से बुकमार्क, पासवर्ड और सेटिंग इंपोर्ट करें — किसी खाते की ज़रूरत नहीं।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">इंपोर्ट करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">चरण 2. अपना लेआउट चुनें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">वह टैब शैली चुनें जो आपके काम करने के तरीक़े से मेल खाती हो। इसे कभी भी बदला जा सकता है।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">साइडबार टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">आपके टैब, पता बार और टूल — सब एक ही वर्टिकल साइडबार में।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">कॉम्पैक्ट साइडबार</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">आइकॉन वाला साइडबार, जो कर्सर ले जाने पर खुल जाता है — छोटी स्क्रीन के लिए बढ़िया।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">ऊपर टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">ऊपर की ओर क्लासिक टैब — Chrome जैसा जाना-पहचाना लेआउट।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">कॉम्पैक्ट टॉप टैब</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">ऊपर का पतला लेआउट, जो सबसे ज़रूरी चीज़ के लिए ज़्यादा जगह छोड़ता है: पेज।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">लेआउट में किए बदलाव तुरंत लागू होते हैं।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">लेआउट लागू करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">चरण 3. अपना नया टैब सजाएँ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">इसे सादा रखें, या सर्च को सामने रखें।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">नए टैब पर सर्च बॉक्स दिखाएँ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">सर्च बॉक्स दिख रहा है</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">नया टैब बिना किसी ध्यान भटकाव के रहता है</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">आपकी सर्च, आपका अंदाज़</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">अगर आप डिफ़ॉल्ट सर्च के तौर पर Google के अलावा कोई और चुनते हैं, तो Chromium नए टैब की ब्रांडिंग अपने आप बदल देता है।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_TITLE">चरण 4. बिल्ट-इन दमदार टूल</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_DESCRIPTION">Chromium में कुछ वैकल्पिक बिल्ट-इन एक्सटेंशन शामिल हैं। नियंत्रण आपके पास ही रहता है।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_TITLE">uBlock Origin</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_STATUS">डिफ़ॉल्ट रूप से बंद</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_DESCRIPTION">तेज़ और साफ़-सुथरे वेब के लिए असरदार कॉन्टेंट ब्लॉकिंग।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_TITLE">Tampermonkey (Legacy)</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_STATUS">डिफ़ॉल्ट रूप से बंद</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_DESCRIPTION">साइटों को गहराई से अपने हिसाब से ढालने के लिए बेहतर यूज़रस्क्रिप्ट मैनेजर।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_MANAGE_BUTTON">एक्सटेंशन प्रबंधित करें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_FOOTNOTE">कुछ बिल्ट-इन टूल, Chrome Web Store पर उपलब्ध संस्करणों से अलग हो सकते हैं।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">चरण 5. आप तैयार हैं</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">बढ़िया। और आगे जाना चाहते हैं? आगे और सुविधाएँ देखें।</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">नया टैब खोलें</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">सेटिंग पर जाएँ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">एक्सटेंशन →</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_RECOMMENDED">सुझाया गया</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_MINIMAL">न्यूनतम</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_COMING_SOON">जल्द आ रहा है</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_AUTOMATIC">अपने आप</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_ADVANCED">उन्नत</translation>
  <translation id="IDS_CUSTOM_BROWSER_CLOSE">बंद करें</translation>
