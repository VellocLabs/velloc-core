  <translation id="IDS_NEXUS_PERMISSION_FILES_TITLE">Acesso ao sistema de ficheiros</translation>
  <translation id="IDS_NEXUS_PERMISSION_FILES_BODY">Este agente pretende ler e escrever ficheiros no seu computador.</translation>
  <translation id="IDS_NEXUS_PERMISSION_CLIPBOARD_TITLE">Acesso à área de transferência</translation>
  <translation id="IDS_NEXUS_PERMISSION_CLIPBOARD_BODY">Este agente pretende aceder à sua área de transferência.</translation>
  <translation id="IDS_NEXUS_PERMISSION_BROWSER_DATA_TITLE">Acesso aos dados do navegador</translation>
  <translation id="IDS_NEXUS_PERMISSION_BROWSER_DATA_BODY">Este agente pretende aceder aos seus marcadores, histórico e transferências.</translation>
  <translation id="IDS_NEXUS_PERMISSION_NOTIFICATIONS_TITLE">Notificações</translation>
  <translation id="IDS_NEXUS_PERMISSION_NOTIFICATIONS_BODY">Este agente pretende enviar-lhe notificações.</translation>
  <translation id="IDS_NEXUS_PERMISSION_ALLOW">Permitir</translation>
  <translation id="IDS_NEXUS_PERMISSION_DENY">Recusar</translation>
  <translation id="IDS_NEXUS_SETUP_PROVIDER_TITLE">Configure o seu fornecedor de IA</translation>
  <translation id="IDS_NEXUS_SETUP_PROVIDER_BODY">Escolha um fornecedor de IA e introduza as suas credenciais para começar.</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_1">Esta funcionalidade executa o <ph name="PRODUCT_NAME"/> diretamente no navegador, ligando aplicações como WhatsApp, Telegram, Discord e iMessage a assistentes de programação com IA.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_DESCRIPTION">O <ph name="PRODUCT_NAME"/> pode usar vários fornecedores de LLM. Escolha um fornecedor, autentique-se e, em seguida, defina o modelo predefinido.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_ROW_SUBLABEL">O <ph name="PRODUCT_NAME"/> pode usar vários fornecedores de LLM. Escolha um fornecedor, autentique-se e, em seguida, defina o modelo predefinido.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONNECTION_DESCRIPTION">Escolha o serviço a que o <ph name="PRODUCT_NAME"/> se deve ligar e verifique a ligação.</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_ROW_SUBLABEL">Configure o URL da aplicação web utilizado pelo <ph name="PRODUCT_LONG_NAME"/>.</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DESCRIPTION">Defina um URL personalizado para a aplicação web do <ph name="PRODUCT_NAME"/>. Deixe vazio para usar a experiência predefinida.</translation>
  <translation id="IDS_NEXUS_SETTINGS_OLLAMA_NOTE">Não é necessária qualquer chave de API. O <ph name="PRODUCT_LONG_NAME"/> carrega os modelos a partir do servidor Ollama configurado.</translation>
  <translation id="IDS_NEXUS_SETTINGS_NO_PROVIDER_STATE">As informações do fornecedor do <ph name="PRODUCT_LONG_NAME"/> não estão disponíveis para este perfil.</translation>
  <translation id="IDS_NEXUS_SETTINGS_SELECT_PROVIDER">Selecione um fornecedor</translation>
  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_SECTION_TITLE">Fornecedor</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_EMPTY_STATE">Escolha um fornecedor, introduza os detalhes da ligação e, em seguida, verifique para carregar os modelos.</translation>
  <translation id="IDS_NEXUS_SETTINGS_VERIFY_LOAD_MODELS">Verificar e carregar modelos</translation>
