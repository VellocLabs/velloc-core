  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_NTP_SECTION_TITLE">Nova aba</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_SEARCH">Mostrar a caixa de pesquisa</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">Mostrar o logotipo do mecanismo de pesquisa</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SEARCH_ENGINE">Mecanismo de pesquisa</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_BODY">Comece a usar sua nova aba. Dicas e atalhos para personalizá-la.</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_ACTION">Abrir o guia de introdução</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOADING">Carregando…</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TITLE">Primeiros passos</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BODY">Comece por aqui</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">Primeiros passos com o Chromium</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">Configure o Chromium em um minuto: importe seus dados, escolha uma disposição e ajuste sua nova aba.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">Passo 1. Traga suas coisas</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">Importe favoritos, senhas e configurações de outro navegador — sem precisar de conta.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">Importar</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">Passo 2. Escolha sua disposição</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">Escolha o estilo de abas que combina com o seu jeito de trabalhar. Você pode mudar quando quiser.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">Abas na barra lateral</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">Suas abas, a barra de endereço e as ferramentas em uma única barra lateral vertical.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">Barra lateral compacta</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">Barra lateral com ícones que se expande ao passar o cursor — ótima para telas menores.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">Abas no topo</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">As abas clássicas na parte de cima, com a disposição familiar do Chrome.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">Abas compactas no topo</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">Uma disposição superior mais enxuta, que deixa mais espaço para o que importa: a página.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">As mudanças de disposição valem na hora.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">Aplicar a disposição</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">Passo 3. Personalize sua nova aba</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">Deixe tudo limpo ou mantenha a pesquisa em destaque.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">Mostrar a caixa de pesquisa na nova aba</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">A caixa de pesquisa está visível</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">A nova aba fica livre de distrações</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">Sua pesquisa, seu visual</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">Se você escolher uma pesquisa padrão que não seja o Google, o Chromium atualiza automaticamente a identidade visual da nova aba.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_TITLE">Passo 4. Ferramentas internas poderosas</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_DESCRIPTION">O Chromium inclui extensões internas opcionais. Você continua no controle.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_TITLE">uBlock Origin</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_STATUS">Desativado por padrão</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_DESCRIPTION">Bloqueio de conteúdo eficiente para uma web mais rápida e limpa.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_TITLE">Tampermonkey (Legacy)</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_STATUS">Desativado por padrão</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_DESCRIPTION">Gerenciador avançado de userscripts para personalizar sites a fundo.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_MANAGE_BUTTON">Gerenciar extensões</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_FOOTNOTE">Algumas ferramentas internas podem ser diferentes do que está disponível na Chrome Web Store.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">Passo 5. Tudo pronto</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">Muito bem. Quer ir além? Explore mais recursos a seguir.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">Abrir uma nova aba</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">Ir para as configurações</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">Extensões →</translation>
