<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE translationbundle>
<translationbundle lang="ko">
  <translation id="IDS_CUSTOM_BROWSER_MODES_HEADER">레이아웃</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR">사이드바 탭</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR_DESCRIPTION">사이드바에 세로 탭을 표시합니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR">사이드바 탭 · 간결하게</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR_DESCRIPTION">사이드바에 아이콘만 있는 세로 탭을 표시합니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD">상단 탭</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD_DESCRIPTION">상단 바에 가로 탭을 표시합니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD">상단 탭 · 간결하게</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD_DESCRIPTION">포인터를 올리면 나타나는 가로 탭입니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_NTP_SECTION_TITLE">새 탭</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_SEARCH">검색창 표시</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">검색 제공업체 로고 표시</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SEARCH_ENGINE">검색엔진</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_BODY">새 탭을 시작해 보세요. 나만의 화면으로 꾸미는 팁과 바로가기를 알려 드립니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_ACTION">시작 가이드 열기</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOADING">불러오는 중…</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TITLE">시작하기</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BODY">여기서 시작하세요</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">Chromium 시작하기</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">1분이면 Chromium 설정이 끝납니다. 데이터를 가져오고, 레이아웃을 고르고, 새 탭을 다듬어 보세요.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">1단계. 쓰던 자료 가져오기</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">북마크, 비밀번호, 설정을 다른 브라우저에서 가져옵니다. 계정은 필요 없습니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">가져오기</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">2단계. 레이아웃 고르기</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">일하는 방식에 맞는 탭 스타일을 고르세요. 언제든 바꿀 수 있습니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">사이드바 탭</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">탭, 주소창, 도구를 하나의 세로 사이드바에 모읍니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">간결한 사이드바</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">아이콘 위주로 두었다가 포인터를 올리면 펼쳐지는 사이드바입니다. 화면이 작을 때 좋습니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">상단 탭</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">위쪽에 늘어선 익숙한 탭. Chrome과 비슷한 레이아웃입니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">간결한 상단 탭</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">상단을 얇게 만들어 정작 중요한 페이지에 더 많은 공간을 남기는 레이아웃입니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">레이아웃 변경은 즉시 적용됩니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">레이아웃 적용</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">3단계. 새 탭 꾸미기</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">깔끔하게 두거나, 검색을 앞에 둘 수 있습니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">새 탭에 검색창 표시</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">검색창이 보입니다</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">새 탭이 산만하지 않게 유지됩니다</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">검색도, 모양도 내 취향대로</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">Google이 아닌 검색엔진을 기본값으로 고르면, Chromium이 새 탭의 브랜드 표시를 자동으로 바꿉니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_TITLE">4단계. 기본 제공되는 강력한 도구</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_DESCRIPTION">Chromium에는 선택해서 쓸 수 있는 기본 제공 확장 프로그램이 들어 있습니다. 결정권은 당신에게 있습니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_TITLE">uBlock Origin</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_STATUS">기본값은 꺼짐</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_DESCRIPTION">효율적인 콘텐츠 차단으로 더 빠르고 깔끔한 웹을 만듭니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_TITLE">Tampermonkey(레거시)</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_STATUS">기본값은 꺼짐</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_DESCRIPTION">사이트를 깊이 있게 바꿀 수 있는 고급 사용자 스크립트 관리 도구입니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_MANAGE_BUTTON">확장 프로그램 관리</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_FOOTNOTE">일부 기본 제공 도구는 Chrome 웹 스토어에서 제공되는 것과 다를 수 있습니다.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">5단계. 준비 완료</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">수고하셨습니다. 더 알아볼까요? 다음으로 다른 기능들을 살펴보세요.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">새 탭 열기</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">설정으로 이동</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">확장 프로그램 →</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_RECOMMENDED">권장</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_MINIMAL">최소</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_COMING_SOON">곧 제공</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_AUTOMATIC">자동</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_ADVANCED">고급</translation>
  <translation id="IDS_CUSTOM_BROWSER_CLOSE">닫기</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_MENU_LABEL">Chromium 시작하기</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOGO_ALT">Chromium 로고</translation>
  <translation id="IDS_CUSTOM_BROWSER_BUILTIN_EXTENSION_TITLE">기본 제공 확장 프로그램</translation>
