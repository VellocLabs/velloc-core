module nexus.mojom;

import "mojo/public/mojom/base/big_buffer.mojom";
import "mojo/public/mojom/base/file_path.mojom";
import "sandbox/policy/mojom/sandbox.mojom";

// One discovered external tool (shell or binary) on the host machine.
//
// Reported by `NexusShellService.GetCapabilities()` so the guest runtime
// (nexus_web SharedWorker) and the LLM can reason about which shells and
// utilities are usable on this host before issuing an Exec request.
struct ShellResolvedTool {
  // Stable lookup key used by the guest tool layer (e.g. "rg", "git",
  // "bash", "pwsh", "powershell", "cmd"). Lowercase, no extension.
  string id;

  // Absolute path to the resolved executable. Empty when `available` is
  // false. The guest is not expected to interpret this path; it is purely
  // diagnostic / for surfacing in error messages.
  mojo_base.mojom.FilePath path;

  // First line of `<tool> --version` output, trimmed and capped to a
  // reasonable length. Empty when the probe failed or the tool does not
  // implement a `--version` flag (e.g. `cmd.exe`).
  string version;

  // True iff the executable was located AND (when applicable) responded to
  // a `--version` probe. Tools that exist but cannot be probed (notably
  // `cmd.exe`) are still reported as available with an empty `version`.
  bool available;
};

// One environment-variable entry passed to a child process. Mojo maps do
// not preserve insertion order, but env entries do — when the same key
// appears more than once, the *last* entry wins, matching POSIX
// `execve` and Windows CreateProcess semantics.
struct ShellEnvEntry {
  string name;
  string value;
};

// Inputs to `NexusShellService.Exec()`.
struct ShellSpawnOptions {
  // Either:
  //   * a known tool id (e.g. "rg", "git"); resolved to an absolute path
  //     by the service against the same allowlist that
  //     `GetCapabilities()` reports, OR
  //   * an absolute path that must canonicalise to one of the resolved
  //     tool paths reported by `GetCapabilities()`.
  // Anything else is rejected with COMMAND_NOT_ALLOWED.
  string command;

  // Argv excluding argv[0]. Each entry is passed verbatim — no shell
  // interpolation. Use the `use_shell` field if you actually need a
  // shell to interpret a string.
  array<string> args;

  // Working directory. Must be absolute, must exist, and must be a
  // directory. The service rejects anything else with INVALID_CWD.
  // Phase 2 adds optional confinement to a per-profile root.
  mojo_base.mojom.FilePath cwd;

  // Additional / overriding env vars. Combined with the
  // `SafeCommandPolicy` baseline (PATH, HOME/USERPROFILE, SystemRoot,
  // etc. — see safe_command_policy.cc). Setting a baseline key here
  // overrides the inherited value; setting a non-baseline key adds it.
  // Forbidden keys (LD_PRELOAD, DYLD_*, etc.) are silently dropped.
  array<ShellEnvEntry> env;

  // When true, prepend the host's resolved default shell + its "-c" /
  // "/C" flag and pass `args` joined by spaces as the single command
  // string. When false, `command` is invoked directly. Phase 1 default
  // is false; the `Bash` tool sets it to true.
  bool use_shell;

  // Bytes written to the child's stdin, after which the stream is closed
  // (EOF). Empty means the child sees an empty stdin (NUL / /dev/null),
  // matching the prior behaviour. Used to deliver hook-input JSON to
  // command hooks the same way Claude Code does via `child.stdin.write`,
  // without the caller having to compose a `printf '<json>' | …` pipeline
  // (which only works in a POSIX shell). UTF-8; carried as a string
  // because hook input is always JSON text.
  string stdin_data;

  // Hard wall-clock cap. The service kills the process tree (Job Object
  // on Windows, process group on POSIX) when this elapses. 0 means
  // "use the service default" (currently 30 000 ms — see
  // safe_command_policy.cc). Capped at 5 minutes server-side.
  uint32 timeout_ms;

  // Per-stream output cap. Once exceeded, additional bytes are
  // dropped and the matching `_truncated` flag in the result is set.
  // 0 means "use the service default" (currently 1 MiB per stream).
  // Capped at 16 MiB server-side.
  uint32 max_output_bytes;

  // Foreground-only. When true and the command exceeds `timeout_ms`, the
  // service does NOT kill it — instead it detaches the still-running
  // process into the background registry (the same one `Spawn` uses) and
  // the `Exec` reply carries `result.background_shell_id` so the caller can
  // poll `ReadBackgroundOutput`. The detached child then runs under the
  // hard server cap (kMaxTimeoutMs), not `timeout_ms`. Mirrors Claude
  // Code's auto-background-on-timeout for non-`sleep` foreground commands
  // (claude_code BashTool `onTimeout` → `startBackgrounding`). Default
  // false: `timeout_ms` is a hard kill, as before. Ignored by `Spawn` /
  // `StreamSpawn`.
  bool background_on_timeout;
};

// Process-exit summary. Exactly one of `code` and `signal` is non-null
// on POSIX; on Windows `signal` is always null.
struct ShellExitInfo {
  int32? code;
  int32? signal;

  // True iff the service killed the process because `timeout_ms`
  // expired before it exited on its own.
  bool timed_out;

  // True when the service forcibly killed the process for any reason
  // (timeout, output cap exceeded, parent disconnect). `timed_out`
  // implies `killed`; the inverse does not hold.
  bool killed;

  // Wall-clock duration from spawn to exit (or kill).
  uint64 duration_ms;
};

// Result of a one-shot `Exec` call.
struct ShellExecResult {
  ShellExitInfo exit;

  // Captured stdout/stderr, capped to `max_output_bytes` per stream.
  // Always present (possibly empty); never null.
  mojo_base.mojom.BigBuffer stdout_buffer;
  mojo_base.mojom.BigBuffer stderr_buffer;

  bool stdout_truncated;
  bool stderr_truncated;

  // Set only when the request had `background_on_timeout = true` AND the
  // command crossed `timeout_ms` before exiting: the command was NOT
  // killed — it was detached to the background registry under this id and
  // keeps running. The caller surfaces it like a `Spawn` result and polls
  // `ReadBackgroundOutput(background_shell_id)`. Null on every normal
  // (exited or killed) Exec. When set, `exit.timed_out` is true and
  // `exit.killed` is false, and the output buffers are empty (output is
  // captured at the eventual real exit, retrievable via
  // ReadBackgroundOutput).
  string? background_shell_id;
};

// Status + accumulated output of a background process started by
// `Spawn`, returned by `ReadBackgroundOutput`. Shell ids are opaque and
// process-unique (`bg_<uuid>`); callers must not parse or assume a counter.
struct ShellBackgroundOutput {
  // False when `shell_id` is unknown (never existed or was evicted).
  // When false every other field is at its default.
  bool found;

  // True while the process is still executing. When false the process
  // has exited (or was killed at timeout) and `exit` is populated.
  bool running;

  // Output captured so far. While `running` is true these buffers carry the
  // latest accumulated stdout/stderr snapshots collected by the native runner;
  // once the child exits they carry the final capped output.
  mojo_base.mojom.BigBuffer stdout_buffer;
  mojo_base.mojom.BigBuffer stderr_buffer;

  bool stdout_truncated;
  bool stderr_truncated;

  // Null while `running`; populated once the process has exited.
  ShellExitInfo? exit;
};

// Controller handle for a long-lived streaming child process started by
// `StreamSpawn` (slice 4). Held by the BROWSER as a
// `mojo::Remote<NexusStreamingProcess>`; each method routes to the
// utility process, which owns the live child. Unlike `Exec` (one-shot)
// and `Spawn` (batch output at exit), the child here stays running and
// the caller streams data in/out over its whole lifetime.
//
// Primary consumer: the native MCP host (`NexusMcpHost`), which keeps a
// stdio MCP server alive across a JSON-RPC `initialize` handshake plus
// many `tools/call` requests on the SAME process.
interface NexusStreamingProcess {
  // Append bytes to the child's stdin. The stream stays OPEN (contrast
  // with `Exec`'s one-shot `stdin_data`, which closes stdin after the
  // single write) so the caller can write many frames over time.
  // Successive calls preserve send order. Writes issued before the
  // child has finished launching are queued and flushed in order once
  // it is live.
  WriteStdin(array<uint8> data);

  // Close the child's stdin (deliver EOF). Optional — most MCP stdio
  // servers run until killed. Idempotent.
  CloseStdin();

  // Terminate the child process tree (Job Object on Windows, killpg on
  // POSIX) and tear down the pumps. Idempotent. The client's `OnExit`
  // fires (with `killed = true`) once teardown completes.
  Kill();
};

// Observer for a streaming child process (slice 4). Implemented by the
// BROWSER (a `mojo::Receiver<NexusStreamingProcessClient>` passed into
// `StreamSpawn`); the utility process pushes output + lifecycle here.
// All callbacks arrive on the browser binding sequence, in order.
interface NexusStreamingProcessClient {
  // A chunk of stdout bytes as they arrive. Chunk boundaries are
  // ARBITRARY — not line- or JSON-RPC-frame-aligned. The consumer
  // (NexusMcpHost) reassembles into newline-delimited frames itself.
  OnStdout(array<uint8> data);

  // A chunk of stderr bytes. MCP stdio servers log diagnostics here;
  // the host surfaces them on connect failure.
  OnStderr(array<uint8> data);

  // The child exited or was killed. TERMINAL: no further callbacks
  // after this. `exit` carries code / signal / killed / duration —
  // the same struct `Exec` returns.
  OnExit(ShellExitInfo exit);
};

// Observer for a background process started by `SpawnWithObserver`.
// Implemented by the BROWSER (the per-Profile `NexusShellServiceLauncher`);
// the utility process pushes the terminal exit here ONCE, when the child
// exits or is killed. This is the background-shell analogue of
// `NexusStreamingProcessClient.OnExit` (slice 4): it lets the browser learn
// a backgrounded command finished WITHOUT polling `ReadBackgroundOutput`
// on a timer. The browser then fans the exit out to the guest (nexus_web)
// as a `shell.onExit` bridge event so the SharedWorker can finalize the
// `local_bash` task event-driven instead of via its 150ms→1500ms poll loop.
//
// Lifetime: the utility holds the matching `Remote` on the background entry
// and fires `OnExit` from `OnBackgroundComplete`; the entry (and thus the
// remote) survives until eviction, so a late browser subscriber can still be
// served from the launcher's terminal-exit cache. TERMINAL: exactly one
// `OnExit` per spawned shell; nothing is sent after it.
interface NexusBackgroundShellObserver {
  OnExit(string shell_id, ShellExitInfo exit);
};

// Sandboxed-utility-process service exposing host-shell capabilities to
// nexus_web. See `web-ui/test/docs/agents/nexus-process.md` for the full
// design.
//
// Slice 1 added `GetCapabilities`; slice 2 added `Exec`; slice 4 (this
// revision) adds the long-lived streaming `StreamSpawn` path.
//
// ServiceSandbox=kNoSandbox is required because this service intentionally
// spawns *child* processes (the resolved host shell / utility binaries).
// The standard utility sandbox forbids `CreateProcess` / `fork+exec` and
// would defeat the purpose. Hardening of the spawned children is layered
// on top via SafeCommandPolicy (env + cwd + allowlist) and — in slice 4 —
// Job Object containment on Windows / killpg + rlimit on POSIX. The
// utility process itself is still isolated from the browser's renderer
// and network state by virtue of being a separate process.
[ServiceSandbox=sandbox.mojom.Sandbox.kNoSandbox]
interface NexusShellService {
  // See ShellResolvedTool / `GetCapabilities` doc on slice 1.
  GetCapabilities() => (string platform,
                        ShellResolvedTool? default_shell,
                        array<ShellResolvedTool> tools,
                        array<string> command_allowlist);

  // Synchronous (from the caller's perspective) child-process invocation.
  //
  // Returns:
  //   * `ok = true` and a populated `result` when the child was launched
  //     and either exited on its own or was killed by the service; in
  //     either case `result.exit.code` / `signal` describe the outcome
  //     and the caller should consult `timed_out` / `killed` for cause.
  //   * `ok = false`, `result = null`, and `error_code` / `error_message`
  //     populated when the request was rejected before launch (e.g.
  //     COMMAND_NOT_ALLOWED, INVALID_CWD, BINARY_NOT_FOUND). Once the
  //     child has been launched, errors flow through `result.exit`
  //     instead of `error_code`.
  // `install_hint` is populated only when `error_code == "BINARY_NOT_FOUND"`.
  // It carries a multi-line, platform-specific instruction string that the
  // guest tool layer surfaces verbatim to the model so it can install the
  // missing binary via the Bash tool and retry. See `install_hints.cc` for
  // the concrete strings.
  Exec(ShellSpawnOptions options)
      => (bool ok,
          ShellExecResult? result,
          string? error_code,
          string? error_message,
          string? install_hint);

  // Launch a command in the BACKGROUND. Returns immediately with an
  // opaque `shell_id` once the request passes the same validation /
  // allowlist / cwd / sandbox checks as `Exec`; the process then runs
  // to completion (or `timeout_ms` kill) on a worker thread while the
  // caller's turn continues. The model retrieves the outcome later via
  // `ReadBackgroundOutput(shell_id)`.
  //
  // `ok=false` with `error_code`/`error_message` (and `install_hint`
  // for BINARY_NOT_FOUND) is returned for PRE-LAUNCH rejections only —
  // exactly mirroring `Exec`. Once launched, the process outcome flows
  // through `ReadBackgroundOutput`, never here.
  Spawn(ShellSpawnOptions options)
      => (bool ok,
          string? shell_id,
          string? error_code,
          string? error_message,
          string? install_hint);

  // Identical to `Spawn` (same validation / allowlist / cwd / sandbox / reply
  // contract), but the caller additionally supplies an `observer` remote that
  // the utility will call ONCE via `NexusBackgroundShellObserver.OnExit` when
  // the backgrounded child reaches a terminal state (exit or kill). Lets the
  // browser detect completion event-driven instead of polling
  // `ReadBackgroundOutput`. `ReadBackgroundOutput(shell_id)` still works for
  // fetching the accumulated output on demand. Pre-launch rejections reply
  // here exactly like `Spawn` (the observer is simply never called).
  SpawnWithObserver(ShellSpawnOptions options,
                    pending_remote<NexusBackgroundShellObserver> observer)
      => (bool ok,
          string? shell_id,
          string? error_code,
          string? error_message,
          string? install_hint);

  // Poll a background process started by `Spawn`. See
  // `ShellBackgroundOutput`. Idempotent and side-effect-free; the entry
  // survives reads so the model can poll repeatedly.
  ReadBackgroundOutput(string shell_id) => (ShellBackgroundOutput output);

  // Kill a background process started by `Spawn` (or a foreground command
  // detached via `background_on_timeout`). Terminates the process tree (Job
  // Object on Windows, killpg on POSIX); the entry SURVIVES so the caller can
  // still `ReadBackgroundOutput` it (it reports `running=false`,
  // `exit.killed=true` once the runner observes the termination). Idempotent:
  // killing an already-finished id is a no-op.
  //
  //   * `found`       — false iff `shell_id` was never registered or has been
  //                     evicted; true otherwise.
  //   * `was_running` — true iff the process was still executing at kill time
  //                     (i.e. an actual termination was issued); false if it
  //                     had already exited (no-op).
  Kill(string shell_id) => (bool found, bool was_running);

  // Launch a LONG-LIVED child with live, bidirectional stdio (slice 4).
  // The caller supplies a `controller` receiver (it keeps the matching
  // `Remote<NexusStreamingProcess>` to write stdin / kill) and a
  // `client` remote (the utility pushes stdout/stderr/exit to it). The
  // child runs until it exits on its own or the controller's `Kill` is
  // called.
  //
  // Validation (allowlist / cwd / env / shell-rewrite) is IDENTICAL to
  // `Exec` — same `PrepareExec` policy. Two field-semantics differences:
  //   * `stdin_data` is IGNORED — use `NexusStreamingProcess.WriteStdin`.
  //   * `timeout_ms` is IGNORED — streaming children have no wall-clock
  //     cap (an MCP server is meant to outlive any single request);
  //     lifetime is controller-driven via `Kill`.
  //
  // Reply: `ok = false` with `error_code` / `error_message` (+
  // `install_hint` for BINARY_NOT_FOUND) for PRE-LAUNCH rejections —
  // exactly mirroring `Exec` / `Spawn`. On `ok = true` the child was
  // launched and the controller is bound; runtime failures thereafter
  // flow through the client's `OnExit`.
  StreamSpawn(ShellSpawnOptions options,
              pending_receiver<NexusStreamingProcess> controller,
              pending_remote<NexusStreamingProcessClient> client)
      => (bool ok,
          string? error_code,
          string? error_message,
          string? install_hint);
};
