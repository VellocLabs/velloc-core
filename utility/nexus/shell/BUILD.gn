import("//build/config/chrome_build.gni")
import("//testing/test.gni")

assert(enable_custom_browser)

# Host-shell capability probe (PATH lookup + --version probe). Pure C++,
# no Mojo, so it can be unit-tested without spinning up a service runner.
# The `--version` probe reuses the child-process runner so it launches with
# CREATE_NO_WINDOW on Windows (no console-window flashing).
source_set("shell_resolver") {
  sources = [
    "shell_resolver.cc",
    "shell_resolver.h",
  ]

  public_deps = [ "//base" ]

  deps = [
    ":child_process_runner",

    # GetManagedBinaryPath() — lets FindOnPath resolve a downloaded
    # binary under ~/.velloc/bin.
    "//custom_browser/common",
  ]
}

# Platform-specific install hints used when a known tool is missing from
# PATH. Pure C++ string tables; no I/O. Kept separate from the policy so
# the policy unit tests can stay focused.
source_set("install_hints") {
  sources = [
    "install_hints.cc",
    "install_hints.h",
  ]

  public_deps = [ "//base" ]
}

# Pre-launch policy checks (allowlist, env sanitiser, cwd validator).
# Used by the service impl AND its unit tests.
source_set("safe_command_policy") {
  sources = [
    "safe_command_policy.cc",
    "safe_command_policy.h",
  ]

  public_deps = [
    ":install_hints",
    ":shell_resolver",
    "//base",
  ]

  # IsUnderManagedBinDir() — allow execing an absolute path under
  # ~/.velloc/bin (the trusted installer output dir).
  deps = [ "//custom_browser/common" ]
}

# Cross-platform child-process runner (LaunchProcess + temp-file
# capture + timeout-kill). Blocking; must run on a base::MayBlock()
# thread.
source_set("child_process_runner") {
  sources = [
    "child_process_runner.cc",
    "child_process_runner.h",
  ]

  public_deps = [ "//base" ]
}

# Media Read processors (images, notebooks, PDFs). CPU-heavy media work lives in
# the utility process, outside the browser UI process.
source_set("media_service") {
  sources = [
    "../media/image_processor.cc",
    "../media/image_processor.h",
    "../media/media_limits.h",
    "../media/media_read_result.cc",
    "../media/media_read_result.h",
    "../media/nexus_media_service_impl.cc",
    "../media/nexus_media_service_impl.h",
    "../media/notebook_processor.cc",
    "../media/notebook_processor.h",
    "../media/pdf_processor.cc",
    "../media/pdf_processor.h",
  ]

  public_deps = [
    "//base",
    "//custom_browser/browser/nexus/mojom",
    "//mojo/public/cpp/base",
    "//mojo/public/cpp/bindings",
  ]

  deps = [
    "//pdf",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
  ]
}

# Transcript span-index search. Scanning and matching megabytes of JSONL is
# CPU work, and the `.sdi` sidecars are read and rewritten here too — the
# browser process owns neither. `:transcript_search` is a leaf target
# (//base + re2), so hosting it here costs nothing extra.
source_set("search_service") {
  sources = [
    "../search/nexus_search_service_impl.cc",
    "../search/nexus_search_service_impl.h",
  ]

  public_deps = [
    "//base",
    "//custom_browser/browser/nexus/mojom",
    "//mojo/public/cpp/base",
    "//mojo/public/cpp/bindings",
  ]

  deps = [ "//custom_browser/browser/nexus:transcript_search" ]
}

# Slice-4 long-lived streaming child process: live stdio pipes + an
# implementation of `mojom::NexusStreamingProcess`. Used by the native MCP
# host transport. Blocking pump/wait loops run on dedicated thread-pool
# sequences.
source_set("streaming_child_process") {
  sources = [
    "streaming_child_process.cc",
    "streaming_child_process.h",
  ]

  public_deps = [
    ":child_process_runner",
    "//base",
    "//custom_browser/browser/nexus/mojom",
    "//mojo/public/cpp/bindings",
  ]
}

# The pseudoconsole entry points (F-31): the bundled console host next to
# chrome.dll first, kernel32's ConPTY second. A leaf (//base + common) so the
# browser process can ask the same question the utility answers.
source_set("pty_console_host") {
  sources = [
    "pty_console_host.cc",
    "pty_console_host.h",
  ]

  public_deps = [ "//base" ]

  deps = [ "//custom_browser/common" ]

  # The bundled host the loader resolves first, copied next to the binary.
  if (is_win) {
    data_deps = [ "//custom_browser/installer:console_host" ]
  }
}

# A streaming child under a Windows pseudoconsole (F-31): the terminal's
# shell. Same ownership and mojom interface as the pipe child above.
source_set("pty_child_process") {
  sources = []
  if (is_win) {
    sources += [
      "pty_child_process.cc",
      "pty_child_process.h",
    ]
  }

  public_deps = [
    ":child_process_runner",
    ":pty_console_host",
    "//base",
    "//custom_browser/browser/nexus/mojom",
    "//mojo/public/cpp/bindings",
  ]
}

# `nexus.mojom.NexusShellService` implementation. Slice 2: GetCapabilities
# + Exec; slice 4: streaming StreamSpawn.
source_set("nexus_shell_service") {
  sources = [
    "nexus_shell_service_impl.cc",
    "nexus_shell_service_impl.h",
  ]

  public_deps = [
    ":child_process_runner",
    ":pty_child_process",
    ":pty_console_host",
    ":safe_command_policy",
    ":shell_resolver",
    ":streaming_child_process",
    "//base",
    "//custom_browser/browser/nexus/mojom",
    "//mojo/public/cpp/base",
    "//mojo/public/cpp/bindings",
    "//pdf",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
  ]
}

# Glue that hands a `RunNexusShellService` factory to the upstream
# `mojo::ServiceFactory`. Linked into chrome/utility once the upstream
# hook lands; until then it is unreferenced but kept buildable so future
# wiring is a one-liner.
source_set("services") {
  sources = [
    "services.cc",
    "services.h",
  ]

  public_deps = [ "//mojo/public/cpp/bindings" ]

  deps = [
    ":media_service",
    ":nexus_shell_service",
    ":search_service",
    "//custom_browser/browser/nexus/mojom",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "../media/media_processor_unittest.cc",
    "child_process_runner_unittest.cc",
    "install_hints_unittest.cc",
    "nexus_shell_service_impl_unittest.cc",
    "pty_console_host_unittest.cc",
    "safe_command_policy_unittest.cc",
    "shell_resolver_unittest.cc",
  ]
  if (is_win) {
    sources += [ "pty_child_process_unittest.cc" ]
  }

  deps = [
    ":child_process_runner",
    ":install_hints",
    ":media_service",
    ":nexus_shell_service",
    ":pty_child_process",
    ":pty_console_host",
    ":safe_command_policy",
    ":shell_resolver",
    "//base",
    "//base/test:test_support",
    "//custom_browser/browser/nexus/mojom",

    # GetManagedBinaryPath() for the managed-binary resolver/policy tests.
    "//custom_browser/common",

    # The PDF media test loads the V8 snapshot pdfium needs.
    "//gin",
    "//mojo/public/cpp/base",
    "//mojo/public/cpp/bindings",
    "//testing/gtest",
    "//tools/v8_context_snapshot:buildflags",
  ]

  # Defines V8_USE_EXTERNAL_STARTUP_DATA, which gates gin's LoadV8Snapshot().
  configs += [ "//v8:external_startup_data" ]
}

# Standalone test binary for the nexus shell unit tests. A Nexus-owned binary,
# deliberately separate from Chromium's //chrome/test:unit_tests. The tests bind
# a mojo::Remote to the service impl, so the main must initialize mojo core —
# //mojo/core/test:run_all_unittests supplies a mojo-aware TestSuite main. Run:
#   autoninja -C out/Debug custom_browser_nexus_shell_unittests
#   out/Debug/custom_browser_nexus_shell_unittests
test("custom_browser_nexus_shell_unittests") {
  deps = [
    ":unit_tests",
    "//mojo/core/test:run_all_unittests",
    "//testing/gtest",
  ]
}
