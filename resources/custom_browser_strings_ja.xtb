<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE translationbundle>
<translationbundle lang="ja">
  <translation id="IDS_CUSTOM_BROWSER_MODES_HEADER">レイアウト</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR">サイドバータブ</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR_DESCRIPTION">サイドバーに縦向きのタブを表示します。</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR">サイドバータブ · コンパクト</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR_DESCRIPTION">サイドバーにアイコンだけの縦向きタブを表示します。</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD">上部タブ</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD_DESCRIPTION">上部のバーに横向きのタブを表示します。</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD">上部タブ · コンパクト</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD_DESCRIPTION">ポインタを合わせたときに現れる横向きのタブです。</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_NTP_SECTION_TITLE">新しいタブ</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_SEARCH">検索ボックスを表示</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">検索プロバイダのロゴを表示</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SEARCH_ENGINE">検索エンジン</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_BODY">新しいタブを使ってみましょう。カスタマイズのヒントとショートカットを紹介します。</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_ACTION">スタートガイドを開く</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOADING">読み込み中…</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TITLE">はじめに</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BODY">ここから始めましょう</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">Chromium をはじめよう</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">1 分で Chromium を設定しましょう。データをインポートし、レイアウトを選び、新しいタブを整えます。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">ステップ 1. データを引き継ぐ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">ブックマーク、パスワード、設定を別のブラウザからインポートします。アカウントは不要です。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">インポート</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">ステップ 2. レイアウトを選ぶ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">自分の使い方に合うタブのスタイルを選びましょう。いつでも変更できます。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">サイドバータブ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">タブ、アドレスバー、ツールを 1 つの縦型サイドバーにまとめます。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">コンパクトサイドバー</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">アイコン中心で、ポインタを合わせると広がるサイドバーです。画面の狭い環境に向いています。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">上部タブ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">上部に並ぶ従来型のタブ。Chrome に近い使い心地のレイアウトです。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">コンパクト上部タブ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">上部を細くして、大事なもの（ページ）により多くの余白を残すレイアウトです。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">レイアウトの変更はすぐに反映されます。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">レイアウトを適用</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">ステップ 3. 新しいタブをカスタマイズ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">すっきり保つか、検索を前面に出すかを選べます。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">新しいタブに検索ボックスを表示</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">検索ボックスを表示中</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">新しいタブは気が散らないまま</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">検索も、見た目も自分好みに</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">Google 以外を既定の検索に選ぶと、Chromium は新しいタブのブランド表示を自動で切り替えます。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_TITLE">ステップ 4. 組み込みの強力なツール</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_DESCRIPTION">Chromium には任意で使える組み込みの拡張機能が含まれています。主導権はあなたにあります。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_TITLE">uBlock Origin</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_STATUS">デフォルトでオフ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_DESCRIPTION">効率的なコンテンツブロックで、ウェブをより速く、すっきりと。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_TITLE">Tampermonkey（レガシー）</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_STATUS">デフォルトでオフ</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_DESCRIPTION">サイトを深くカスタマイズできる、上級者向けのユーザースクリプト管理ツールです。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_MANAGE_BUTTON">拡張機能を管理</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_FOOTNOTE">組み込みツールの一部は、Chrome ウェブストアで提供されるものと異なる場合があります。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">ステップ 5. 準備完了</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">お疲れさまでした。さらに使いこなしますか？次は他の機能を見てみましょう。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">新しいタブを開く</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">設定に移動</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">拡張機能 →</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_RECOMMENDED">推奨</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_MINIMAL">ミニマル</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_COMING_SOON">近日公開</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_AUTOMATIC">自動</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_ADVANCED">詳細設定</translation>
  <translation id="IDS_CUSTOM_BROWSER_CLOSE">閉じる</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_MENU_LABEL">Chromium をはじめよう</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOGO_ALT">Chromium のロゴ</translation>
  <translation id="IDS_CUSTOM_BROWSER_BUILTIN_EXTENSION_TITLE">組み込みの拡張機能</translation>
  <translation id="IDS_CUSTOM_BROWSER_BUILTIN_DETAILS_NAME">名前</translation>
  <translation id="IDS_CUSTOM_BROWSER_BUILTIN_DETAILS_DESCRIPTION">説明</translation>
  <translation id="IDS_CUSTOM_BROWSER_BUILTIN_DETAILS_VERSION">バージョン</translation>
