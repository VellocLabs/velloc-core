# Registers chrome://nexus as a WebUI host (T011a).
source_set("nexus_webui_config") {
  sources = [
    "nexus_webui_config.cc",
    "nexus_webui_config.h",
  ]

  deps = [ "//base" ]
}

# Nexus toolbar button — placed next to the GLIC button (T011b).
source_set("nexus_toolbar_button") {
  sources = [
    "nexus_toolbar_button.cc",
    "nexus_toolbar_button.h",
  ]

  deps = [ "//base" ]
}

# Per-domain permission manager for Nexus capabilities (T012).
