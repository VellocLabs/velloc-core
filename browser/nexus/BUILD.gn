# Per-session tab-group management. Each Nexus session owns a Chromium
# tab group: BrowserTool tags the new WebContents with the session_key
# (NexusSessionTabTag) and adds it to the group on creation;
# ResolveTabIdOrReject + BuildObservationDict filter by the tag;
# ~BrowserTool closes the session's tabs. The pre-refactor profile-wide
# `NexusSessionTabGroupRegistry` KeyedService was inlined into
# BrowserTool (per-session group_id_, session_tabs_, last_work_tab_
# members) once `ToolsAdapter::OnSessionStopped` stopped erasing the
# ToolSession on per-turn `kCompleted` / `kUserStopped` reasons — the
# registry only existed to bridge BrowserTool lifetimes across that
# erase/recreate cycle.
source_set("session_tab_management") {
  sources = [
    "session/nexus_session_features.cc",
    "session/nexus_session_features.h",
    "session/nexus_session_tab_tag.cc",
    "session/nexus_session_tab_tag.h",
  ]

  deps = [
    "//base",
    "//content/public/browser",
  ]
}

# Pure per-session tab-count fold + diff (//base only). Split out of the
# tracker so the deterministic count-transition coverage can live in the
# `unit_tests_lite` binary without dragging //chrome/browser/ui in. The
# Browser-walking half (NexusSessionTabTracker) is compiled into `:bridge`.
source_set("session_tab_counts") {
  sources = [
    "session/nexus_session_tab_counts.cc",
    "session/nexus_session_tab_counts.h",
  ]

  deps = [ "//base" ]
}

# BrowserUpload's file-chooser interceptor. Tiny standalone target with
# minimal deps so BOTH the nexus tools (`:bridge`, which arms it) and
# upstream `chrome/browser/ui` (the ENABLE_CUSTOM_BROWSER hook in
# Browser::RunFileChooser, which consults it) can depend on it without a
# dependency cycle. Deliberately does NOT depend on //chrome/browser/ui.
source_set("file_chooser_interceptor") {
  sources = [
    "upload/nexus_file_chooser_interceptor.cc",
    "upload/nexus_file_chooser_interceptor.h",
  ]

  deps = [
    "//base",
    "//content/public/browser",
    "//third_party/blink/public/common",
  ]
}

# Out-of-band agent notices — e.g. a native file dialog suppressed on an
# agent-owned tab — queued per-WebContents and drained into the next
# observation by BrowserTool. Like :file_chooser_interceptor, a small
# standalone target with minimal deps so BOTH :bridge (which drains) and
# upstream chrome/browser/ui (the RunFileChooser hook, which records) can
# depend on it without a cycle. Deliberately does NOT depend on
# //chrome/browser/ui.
source_set("agent_notice") {
  sources = [
    "upload/nexus_pending_agent_notice.cc",
    "upload/nexus_pending_agent_notice.h",
  ]

  deps = [
    # NexusSessionTabTag::SessionKeyFor — the agent-owned-tab check.
    ":session_tab_management",
    "//base",
    "//content/public/browser",
    "//third_party/blink/public/common",
  ]
}

# Settings WebUI handler for chrome://settings/nexus (T026).
source_set("nexus_settings_handler") {
  sources = [
    "settings/nexus_settings_handler.cc",
    "settings/nexus_settings_handler.h",
  ]

  deps = [
    ":browser_tools_config",

    # `restartBrowser` — the guest-recovery overlay's "Restart client" button.
    # A leaf that (unlike `:bridge`) does not pull //chrome/browser/ui, so it
    # cannot re-open the ui -> nexus_settings_handler -> bridge -> ui cycle
    # documented on `:mcp_host` below.
    ":client_restart",

    # MCP connection test (`testMcpServer`): builds a transient NexusMcpHost
    # (+ NexusShellServiceLauncher for stdio) to run the handshake before a
    # server is saved. `:mcp_host` is a leaf that (unlike `:bridge`) does NOT
    # pull //chrome/browser/ui, so it avoids the
    # ui -> nexus_settings_handler -> bridge -> ui cycle. `:mcp_server_store`
    # provides the config parser.
    ":mcp_host",
    ":mcp_server_store",
    ":secret_crypt",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/webui/settings",

    # prefs::kBackgroundModeEnabled (constants) + BUILDFLAG(ENABLE_BACKGROUND_MODE)
    # (buildflags) for the System settings background-apps toggle.
    "//chrome/common:buildflags",
    "//chrome/common:constants",
    "//components/prefs",
    "//content/public/browser",
    "//custom_browser/browser/nexus/api/llm",
    "//custom_browser/browser/nexus/api/llm:webui_host",

    # prefs::kNexusLauncherEnabled for the System launcher toggle.
    "//custom_browser/browser/nexus/launcher:prefs",

    # SharedURLLoaderFactory handed to the transient http MCP transport.
    "//services/network/public/cpp",
  ]
}

