  <translation id="IDS_CUSTOM_BROWSER_VERSION_LINE">バージョン <ph name="PRODUCT_VERSION"/>（<ph name="OFFICIAL_LABEL"/>）<ph name="VERSION_MODIFIER"/></translation>
  <translation id="IDS_CUSTOM_BROWSER_BASED_ON_CHROMIUM_LINE">Chromium <ph name="CHROMIUM_VERSION"/> ベース</translation>
  <translation id="IDS_NEXUS_SETTINGS_TITLE"><ph name="PRODUCT_NAME"/></translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_PAGE_TITLE">モデルプロバイダ</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_LABEL">AI プロバイダ</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_LABEL">API キー</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_PLACEHOLDER">API キーを入力</translation>
  <translation id="IDS_NEXUS_SETTINGS_TEST_CONNECTION">接続をテスト</translation>
  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_SUCCESS">接続に成功しました</translation>
  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_FAILED">接続に失敗しました</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_LABEL">カスタムの <ph name="PRODUCT_NAME"/> ウェブアプリ URL</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_PLACEHOLDER">https://your-app.example.com</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_RESET">デフォルトに戻す</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_PAGE_TITLE">エージェントのウェブアプリ URL</translation>
  <translation id="IDS_NEXUS_PROVIDER_OPENAI">OpenAI</translation>
  <translation id="IDS_NEXUS_PROVIDER_ANTHROPIC">Anthropic</translation>
  <translation id="IDS_NEXUS_PROVIDER_GOOGLE">Google AI</translation>
  <translation id="IDS_NEXUS_PROVIDER_OLLAMA">Ollama（ローカル）</translation>
  <translation id="IDS_NEXUS_SETTINGS_MODEL_LABEL">モデル</translation>
  <translation id="IDS_NEXUS_SETTINGS_BASE_URL_LABEL">Base URL</translation>
  <translation id="IDS_NEXUS_SETTINGS_BASE_URL_PLACEHOLDER">http://localhost:11434</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_0">これらの機能は AI を使っており、まだ開発の初期段階のため、常に正しいとは限りません。</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_1">この機能は <ph name="PRODUCT_NAME"/> をブラウザ内で直接実行し、WhatsApp、Telegram、Discord、iMessage などのアプリを AI コーディングアシスタントにつなぎます。</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_2">ブラウザが、チャットをしながら普段のオンライン作業を AI に手伝ってもらえる中心的な場所になります。</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_DESCRIPTION"><ph name="PRODUCT_NAME"/> は多くの LLM プロバイダを利用できます。プロバイダを選んで認証し、デフォルトのモデルを設定してください。</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_ROW_SUBLABEL"><ph name="PRODUCT_NAME"/> は多くの LLM プロバイダを利用できます。プロバイダを選んで認証し、デフォルトのモデルを設定してください。</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONNECTION_DESCRIPTION"><ph name="PRODUCT_NAME"/> が接続するサービスを選び、接続を検証してください。</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_ROW_SUBLABEL"><ph name="PRODUCT_LONG_NAME"/> が使うウェブアプリ URL を設定します。</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DESCRIPTION">カスタムの <ph name="PRODUCT_NAME"/> ウェブアプリ URL を設定します。空欄のままにすると、デフォルトの体験を使います。</translation>
  <translation id="IDS_NEXUS_SETTINGS_OLLAMA_NOTE">API キーは不要です。<ph name="PRODUCT_LONG_NAME"/> は設定済みの Ollama サーバーからモデルを読み込みます。</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_HINT">保存済みのキーをそのまま使う場合は、API キーを空欄のままにしてください。</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_STATUS_LABEL">プロバイダの状態</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONFIGURED">設定済み</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_NOT_CONFIGURED">未設定</translation>
