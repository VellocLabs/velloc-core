source_set("alarm_schedule") {
  sources = [
    "api/alarms/alarm_schedule.cc",
    "api/alarms/alarm_schedule.h",
  ]

  public_deps = [ "//base" ]
}

# The per-Profile alarm clock (KeyedService, created with the profile so
