  <translation id="IDS_CUSTOM_BROWSER_MODES_HEADER">布局</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR">侧边栏标签页</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR_DESCRIPTION">侧边栏上的垂直标签页。</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR">侧边栏标签页 · 紧凑</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR_DESCRIPTION">侧边栏上的纯图标垂直标签页。</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD">顶部标签页</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD_DESCRIPTION">顶栏上的水平标签页。</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD">顶部标签页 · 紧凑</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD_DESCRIPTION">悬停时才显示的水平标签页。</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_NTP_SECTION_TITLE">新标签页</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_SEARCH">显示搜索框</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">显示搜索引擎徽标</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SEARCH_ENGINE">搜索引擎</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_BODY">开始使用你的新标签页。这里有个性化设置的技巧和快捷方式。</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_ACTION">打开入门指南</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOADING">正在加载…</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TITLE">开始使用</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BODY">从这里开始</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">开始使用 Chromium</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">一分钟完成 Chromium 的设置：导入数据、挑选布局、调整新标签页。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">第 1 步：带上你的资料</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">从其他浏览器导入书签、密码和设置 — 无需账号。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">导入</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">第 2 步：选择你的布局</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">挑一种符合你工作习惯的标签页样式。随时可以更换。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">侧边栏标签页</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">标签页、地址栏和工具都集中在一条垂直侧边栏里。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">紧凑侧边栏</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">以图标为主、悬停时展开的侧边栏 — 很适合小屏幕。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">顶部标签页</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">标签页横排在顶部，保持你熟悉的 Chrome 风格布局。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">紧凑顶部标签页</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">更纤薄的顶部布局，把空间留给真正重要的东西：网页本身。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">布局更改立即生效。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">应用布局</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">第 3 步：自定义你的新标签页</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">保持清爽，或者把搜索放在最显眼的位置。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">在新标签页上显示搜索框</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">搜索框可见</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">新标签页保持清爽无干扰</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">你的搜索，你的样子</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">如果你把默认搜索换成非 Google 的引擎，Chromium 会自动更新新标签页上的品牌标识。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">第 4 步：一切就绪</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">干得漂亮。还想再深入一点？接着去看看更多功能吧。</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">打开新标签页</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">前往设置</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">扩展程序 →</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_RECOMMENDED">推荐</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_MINIMAL">极简</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_COMING_SOON">即将推出</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_AUTOMATIC">自动</translation>
  <translation id="IDS_CUSTOM_BROWSER_CLOSE">关闭</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_MENU_LABEL">开始使用 Chromium</translation>
