  <translation id="IDS_NEXUS_SETTINGS_VALIDATE_TITLE">현재 설정 검증</translation>
  <translation id="IDS_NEXUS_SETTINGS_VALIDATE_DESCRIPTION">현재 제공업체 설정을 저장하고 선택한 모델을 테스트합니다.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_READY">현재 설정을 그대로 사용할 수 있습니다.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_SETUP_REQUIRED">이 제공업체가 연결하려면 추가 설정이 필요합니다.</translation>
  <translation id="IDS_NEXUS_SETTINGS_SAVING_PROVIDER">제공업체 설정을 저장하는 중…</translation>
