# Standalone test binary for the lightweight nexus unit tests. Run with:
#   autoninja -C out/Debug custom_browser_nexus_unittests
#   out/Debug/custom_browser_nexus_unittests
test("custom_browser_nexus_unittests") {
  deps = [
    ":unit_tests_lite",
    "//base/test:run_all_unittests",

    # Not nexus-owned, but ui/view's only pure-logic test (the window
    # resize-gutter geometry) belongs in a lite binary and doesn't warrant one
    # of its own.
    "//custom_browser/ui/view:unit_tests",
    "//services/network/public/mojom",
    "//testing/gtest",
  ]
}

# Standalone test binary for the heavier nexus unit tests (the `:unit_tests`
# source_set above). A Nexus-owned binary, deliberately separate from Chromium's
# //chrome/test:unit_tests. `//chrome/test:test_support_unit` supplies the
# ChromeUnitTestSuite main (chrome/test/base/run_all_unittests.cc) — it loads
# the resource paks and stands up TestingBrowserProcess, which the launcher /
# notification-icon / profile-bound tests need. Run with:
#   autoninja -C out/Debug custom_browser_nexus_browser_unittests
#   out/Debug/custom_browser_nexus_browser_unittests
test("custom_browser_nexus_browser_unittests") {
  deps = [
    ":unit_tests",
    "//chrome/test:test_support_unit",
    "//custom_browser/features:unit_tests",
    "//testing/gtest",
  ]
}

