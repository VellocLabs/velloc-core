module nexus.mojom;

interface NexusBridgeBootstrap {
  // Called by the WebUI panel page once the guest <webview> is mounted and
  // ready for the runtime bootstrap. Browser responds by posting a
  // `nexus-bridge-bootstrap` message + 2 transferred MessagePorts back to
  // the calling frame's window — one for the guest's page thread, one for
  // its SharedWorker. The WebUI forwards both ports into the <webview>.
  GuestReady();

  // Called by the WebUI panel page to get a MessagePort to its own
  // NexusBridgePortService, kept by the panel. Independent of GuestReady; each
  // call replaces the previous panel port. The reply is a
  // `nexus-panel-bridge-attach` message with one transferred port.
  AttachPanelBridge();
};
