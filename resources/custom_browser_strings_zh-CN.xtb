  <translation id="IDS_CUSTOM_BROWSER_BADGE_MINIMAL">极简</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_COMING_SOON">即将推出</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_AUTOMATIC">自动</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_ADVANCED">高级</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_OPTIONAL">可选</translation>
