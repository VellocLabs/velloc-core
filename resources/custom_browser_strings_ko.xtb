  <translation id="IDS_NEXUS_SETTINGS_TITLE"><ph name="PRODUCT_NAME"/></translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_PAGE_TITLE">모델 제공업체</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_LABEL">AI 제공업체</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_LABEL">API 키</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_PLACEHOLDER">API 키를 입력하세요</translation>
  <translation id="IDS_NEXUS_SETTINGS_TEST_CONNECTION">연결 테스트</translation>
