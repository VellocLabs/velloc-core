module nexus.mojom;

// The `model.catalog` result (NexusLlmHost -> CatalogToBridge). The request,
// content-part and stream-event types of model.call / streamStart /
// streamRead were removed with those actions (interface 1): the
// runtime speaks every provider's wire format itself.

struct NexusLlmSelection {
  string provider_id;
  string model_id;
};

struct NexusLlmModel {
  string id;
  string label;
  bool enabled;
  bool supports_streaming;
  bool supports_tools;
  string? default_thinking_tier;
  array<string> available_thinking_tiers;
};

struct NexusLlmProvider {
  string id;
  string label;
  string icon_svg;
  bool enabled;
  string? default_model_id;
  array<NexusLlmModel> models;
};

struct NexusLlmCatalog {
  array<NexusLlmProvider> providers;
  NexusLlmSelection? default_selection;
  map<string, string> raw_catalogs;
};
