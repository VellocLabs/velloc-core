import("//build/buildflag_header.gni")
import("//build/config/chrome_build.gni")

buildflag_header("buildflags") {
  header = "buildflags.h"
  visibility = [ "*" ]
  flags = [ "ENABLE_CUSTOM_BROWSER=$enable_custom_browser", 
            "CUSTOM_BROWSER_BRANDING=$custom_browser_branding"]
}

config("custom_browser_icon_config") {
  defines = []
  if (is_win && custom_browser_branding) {
    defines += [
      "CUSTOM_BROWSER_ICON_PATH=\"theme\\\\${branding_path_component}\\\\win\\\\${branding_path_component}.ico\"",
    ]
  }
}

# Contract: $root_gen_dir/custom_browser/exe_name.h, written at gn gen time from
# `custom_browser_exe_name`. Upstream hooks include it under
# ENABLE_CUSTOM_BROWSER; it needs no dep because it exists before any build step.
write_file("$root_gen_dir/custom_browser/exe_name.h",
           [
             "// Generated by //custom_browser/BUILD.gn. Do not edit.",
             "#ifndef CUSTOM_BROWSER_EXE_NAME_H_",
             "#define CUSTOM_BROWSER_EXE_NAME_H_",
             "",
             "#define CUSTOM_BROWSER_EXE_BASENAME \"$custom_browser_exe_name\"",
             "#define CUSTOM_BROWSER_EXE_BASENAME_W L\"$custom_browser_exe_name\"",
             "#define CUSTOM_BROWSER_EXE_FILENAME \"$custom_browser_exe_name.exe\"",
             "#define CUSTOM_BROWSER_EXE_FILENAME_W L\"$custom_browser_exe_name.exe\"",
             "",
             "#endif  // CUSTOM_BROWSER_EXE_NAME_H_",
           ])
