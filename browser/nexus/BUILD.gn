# Lightweight tests that only need base + prefs + gtest. Safe to put in a
# small standalone test binary — no TestingProfile / BrowserTaskEnvironment
# transitively pull in all of //chrome/browser.
source_set("unit_tests_lite") {
  testonly = true

  sources = [
    "domain/domain_sandbox_manager_unittest.cc",
    "api/llm/llm_line_splitter_unittest.cc",
    "api/llm/llm_provider_factory_unittest.cc",
    "api/llm/llm_text_helpers_unittest.cc",
    "api/llm/llm_types_unittest.cc",
    "api/llm/oauth/oauth_providers_unittest.cc",
    "api/llm/oauth/oauth_token_store_unittest.cc",
    "api/llm/provider_config_unittest.cc",
    "permissions/nexus_permission_manager_unittest.cc",
    "codegen/codegen_smoke_unittest.cc",
  ]

  deps = [
    ":domain",
    ":permissions",
    # Codegen smoke test exercises the inline Build<Name>Schema() and
    # Extract() functions emitted into the per-tool *.gen.h files
    # (under $target_gen_dir/tools/). The action dep ensures those
    # headers exist + are regenerated when a *.tool.json changes.
    ":nexus_tools_codegen",
    # The schema-shape assertions construct a `nexus::ToolSchema`,
    # whose out-of-line ctor/dtor live in nexus_tool_schema.cc. The
    # `:tool_schema` source_set is deliberately tiny (only depends on
    # //base) so adding it here doesn't drag bridge into the lite
    # test binary.
    ":tool_schema",
    "//base/test:test_support",
    "//components/prefs",
    "//components/prefs:test_support",
    "//custom_browser/browser/nexus/api/llm:line_splitter",
    "//custom_browser/browser/nexus/api/llm:oauth",
    "//custom_browser/browser/nexus/api/llm:pref_names",
    "//custom_browser/browser/nexus/api/llm:provider",
    "//custom_browser/browser/nexus/api/llm:provider_config",
    "//custom_browser/browser/nexus/api/llm:provider_factory",
    "//custom_browser/browser/nexus/api/llm:text_helpers",
    "//custom_browser/browser/nexus/api/llm:types",
    "//services/network/public/cpp",
    "//testing/gtest",
    "//url",
  ]
}

