  <translation id="IDS_NEXUS_PANEL_TOOLTIP">OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_PANEL_ACCESSIBLE_NAME">打开 OpenClaw in Chrome 面板</translation>
  <translation id="IDS_NEXUS_CONSENT_TITLE">OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_CONSENT_BODY">启用 OpenClaw in Chrome，以便使用你偏好的 AI 提供方自动处理浏览器任务、生成内容并与网页交互。</translation>
  <translation id="IDS_NEXUS_CONSENT_ACCEPT">启用 OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_SETTINGS_TITLE">OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_LABEL">AI 提供方</translation>
