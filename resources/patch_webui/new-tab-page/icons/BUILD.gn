import("//ui/webui/resources/tools/generate_grd.gni")

assert(!is_android)

generate_grd("build_grdp") {
  grd_prefix = "patch_webui"
  out_grd = "$target_gen_dir/resources.grdp"
  input_files = [
    "ask_logo.svg",
    "duckduckgo_logo.svg",
    "ecosia_logo.svg",
    "baidu_logo.svg",
    "yahoo_logo.svg",
    "yandex_logo.svg",
    "bing_logo.svg",
  ]
  input_files_base_dir = rebase_path(".", "//")
  resource_path_prefix = "new-tab-page/icons"
}
