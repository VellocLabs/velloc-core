  <translation id="IDS_NEXUS_PANEL_TOOLTIP">OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_PANEL_ACCESSIBLE_NAME">Ouvrir le panneau OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_CONSENT_TITLE">OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_CONSENT_BODY">Activez OpenClaw in Chrome pour automatiser les tâches du navigateur, générer du contenu et interagir avec les pages Web à l'aide de votre fournisseur d'IA préféré.</translation>
  <translation id="IDS_NEXUS_CONSENT_ACCEPT">Activer OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_SETTINGS_TITLE">OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_LABEL">Fournisseur d'IA</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_LABEL">Clé API</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_PLACEHOLDER">Saisissez votre clé API</translation>
  <translation id="IDS_NEXUS_SETTINGS_TEST_CONNECTION">Tester la connexion</translation>
  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_SUCCESS">Connexion réussie</translation>
  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_FAILED">Échec de la connexion</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_LABEL">URL personnalisée de l'application Web OpenClaw</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_PLACEHOLDER">https://your-openclaw-app.example.com</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_RESET">Réinitialiser par défaut</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_PAGE_TITLE">URL de l'application Web</translation>
  <translation id="IDS_NEXUS_PROVIDER_OPENAI">OpenAI</translation>
  <translation id="IDS_NEXUS_PROVIDER_ANTHROPIC">Anthropic</translation>
  <translation id="IDS_NEXUS_PROVIDER_GOOGLE">Google AI</translation>
  <translation id="IDS_NEXUS_PROVIDER_OLLAMA">Ollama (local)</translation>
  <translation id="IDS_NEXUS_PROVIDER_NEXUS_PROXY">Nexus Cloud</translation>
  <translation id="IDS_NEXUS_SETTINGS_MODEL_LABEL">Modèle</translation>
  <translation id="IDS_NEXUS_SETTINGS_BASE_URL_LABEL">URL de base</translation>
  <translation id="IDS_NEXUS_SETTINGS_BASE_URL_PLACEHOLDER">http://localhost:11434</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_0">Ces fonctionnalités utilisent l'IA, sont encore à un stade précoce de développement et ne seront pas toujours exactes.</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_1">Cette fonctionnalité exécute OpenClaw directement dans le navigateur et connecte des applications comme WhatsApp, Telegram, Discord et iMessage à des assistants de codage IA.</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_2">Elle transforme votre navigateur en un espace central où vous pouvez discuter et utiliser l'IA pour vous aider dans tout ce que vous faites habituellement en ligne.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_DESCRIPTION">Choisissez le fournisseur qui alimente OpenClaw in Chrome et gérez son point de terminaison, ses identifiants et son catalogue de modèles.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_ROW_SUBLABEL">Définissez le fournisseur actif, la clé API, l'URL de base et le modèle chargé.</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_ROW_SUBLABEL">Configurez les URL de l'application Web utilisées par OpenClaw in Chrome.</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DESCRIPTION">Définissez une URL personnalisée pour l'application Web OpenClaw. Laissez-la vide pour utiliser l'expérience par défaut.</translation>
  <translation id="IDS_NEXUS_SETTINGS_OLLAMA_NOTE">Aucune clé API n'est requise. OpenClaw in Chrome charge les modèles depuis le serveur Ollama configuré.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROXY_NOTE">Utilise automatiquement les identifiants de votre compte Shift connecté.</translation>
  <translation id="IDS_NEXUS_SETTINGS_API_KEY_HINT">Laissez la clé API vide pour conserver la clé actuellement enregistrée.</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_STATUS_LABEL">État du fournisseur</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONFIGURED">Configuré</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_NOT_CONFIGURED">Non configuré</translation>
  <translation id="IDS_NEXUS_SETTINGS_NO_PROVIDERS">Aucun fournisseur disponible</translation>
  <translation id="IDS_NEXUS_SETTINGS_NO_PROVIDER_STATE">Les informations du fournisseur OpenClaw in Chrome ne sont pas disponibles pour ce profil.</translation>
  <translation id="IDS_NEXUS_SETTINGS_MODEL_LOADING">Chargement des modèles disponibles...</translation>
