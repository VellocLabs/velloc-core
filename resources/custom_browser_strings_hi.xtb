  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONFIGURED">सेट किया गया</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_NOT_CONFIGURED">सेट नहीं किया गया</translation>
