# Heavier nexus unit tests that need //chrome/test:test_support (a real
# ResourceBundle, TestingBrowserProcess, BrowserTaskEnvironment) — too heavy for
# the lite binary. Consumed by the standalone `custom_browser_nexus_browser_unittests`
# binary below (a Nexus-owned binary; these are deliberately NOT linked into
# Chromium's //chrome/test:unit_tests). See docs/agents/nexus-test.md §3.
source_set("unit_tests") {
  testonly = true

  sources = [
    "api/appearance/nexus_appearance_bridge_adapter_unittest.cc",
    "api/fs/nexus_fs_bridge_adapter_unittest.cc",
    "api/fs/nexus_fs_host_unittest.cc",
    "api/llm/nexus_llm_bridge_support_unittest.cc",
    "api/remote_access/nexus_remote_access_bridge_adapter_unittest.cc",
    "api/sqlite/nexus_sqlite_bridge_adapter_unittest.cc",
    "api/sqlite/nexus_sqlite_connection_unittest.cc",
    "api/ui/nexus_ui_bridge_adapter_unittest.cc",
    "launcher/nexus_background_mode_manager_unittest.cc",
    "nexus_guest_config_unittest.cc",
    "panel/nexus_background_panel_host_unittest.cc",
    # The embedded-relay listener: start/stop/port-in-use/destructor. Needs a
    # real IO-capable task environment, so it lives here not in unit_tests_lite.
    "remote_access/nexus_remote_access_listener_unittest.cc",
    # The UI-thread service: GetStatus() must never synchronously call
    # net::GetNetworkList (the cold-boot DisallowUnresponsiveTasks DCHECK).
    # Needs a real TestingProfile, so it lives here not in unit_tests_lite.
    "remote_access/nexus_remote_access_service_unittest.cc",
    # Lives here, not beside its source: CustomBrowserUiPrefs is compiled into
    # //chrome/browser/ui (browser_view_sources), and this is the only nexus
    # test binary that links that target.
    "//custom_browser/ui/prefs/custom_browser_ui_prefs_unittest.cc",
    # Lives beside its header in ui/view, but the predicate reads
    # views::View::GetVisibleBounds(), which is empty for any view outside a
    # Widget. A real Widget needs ChromeViewsTestBase and the GL/compositor
    # setup of this binary's ChromeUnitTestSuite; the lite binary has neither.
    "//custom_browser/ui/view/view_visible_bounds_unittest.cc",
    # Lives beside its header in ui/web_ui; the header reads
    # content::DropData, which the lite binary does not link.
    "//custom_browser/ui/web_ui/nexus_file_drop_policy_unittest.cc",
    "nexus_test_support.cc",
    "nexus_test_support.h",
    "session/nexus_session_tab_tag_unittest.cc",
    "tools/browser_tool/node_registry_unittest.cc",
    "tools/browser_tool/observation_slim_unittest.cc",
    "tools/browser_tool/screenshot_shaping_unittest.cc",
    "tools/file_tool/file_tool_unittest.cc",
    "tools/nexus_tool_schema_unittest.cc",
    "tools/nexus_tool_signature_unittest.cc",
    "tools/process_tool/nexus_shell_service_launcher_unittest.cc",
    "tools/process_tool/process_tool_unittest.cc",
    "tools/tool_base_unittest.cc",
    "tools/tool_session_unittest.cc",
    "upload/nexus_pending_agent_notice_unittest.cc",
  ]

  deps = [
    ":agent_notice",
    ":bridge",
    ":fs",
    ":sqlite",
    ":guest_config",
    ":remote_access_clients",
    ":session_tab_management",
    ":unit_tests_lite",
    "//base/test:test_support",
    # GlicKeyedServiceFactory — nexus_test_support.cc disables Glic's eager
    # keyed service so building a TestingProfile doesn't crash.
    "//chrome/browser/glic",
    # browser_shutdown::NotifyAppTerminating (launcher quit test).
    "//chrome/browser/lifetime:termination_notification",
    "//chrome/test:test_support",
    "//components/keep_alive_registry",
    "//components/prefs",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//components/tab_groups",
    "//components/tabs:public",
    "//content/public/browser",
    "//custom_browser/browser/nexus/api/llm:pref_registration",
    "//custom_browser/browser/nexus/launcher",
    "//custom_browser/browser/nexus/launcher:prefs",
    "//custom_browser/browser/nexus/panel:background_panel_host",
    "//net",
    "//skia",
    "//testing/gtest",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/views",
    "//ui/views:test_support",
    "//url",
  ]
}

# Standalone test binary for the lightweight nexus unit tests. Run with:
#   autoninja -C out/Debug custom_browser_nexus_unittests
#   out/Debug/custom_browser_nexus_unittests
test("custom_browser_nexus_unittests") {
  deps = [
    ":unit_tests_lite",
    "//base/test:run_all_unittests",

    # Not nexus-owned, but ui/view's only pure-logic test (the window
    # resize-gutter geometry) belongs in a lite binary and doesn't warrant one
    # of its own.
    "//custom_browser/ui/view:unit_tests",
    "//services/network/public/mojom",
    "//testing/gtest",
  ]
}

# Standalone test binary for the heavier nexus unit tests (the `:unit_tests`
# source_set above). A Nexus-owned binary, deliberately separate from Chromium's
# //chrome/test:unit_tests. `//chrome/test:test_support_unit` supplies the
# ChromeUnitTestSuite main (chrome/test/base/run_all_unittests.cc) — it loads
# the resource paks and stands up TestingBrowserProcess, which the launcher /
# notification-icon / profile-bound tests need. Run with:
#   autoninja -C out/Debug custom_browser_nexus_browser_unittests
#   out/Debug/custom_browser_nexus_browser_unittests
test("custom_browser_nexus_browser_unittests") {
  deps = [
    ":unit_tests",
    "//chrome/test:test_support_unit",
    "//custom_browser/features:unit_tests",
    "//testing/gtest",
  ]
}

# Standalone test binary for the prompt-holder registry. The registry is a
# self-contained leaf (only //base), so compile it directly here rather than
