  <translation id="IDS_CUSTOM_BROWSER_MODE_NEXUS"><ph name="PRODUCT_NAME"/></translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_NEXUS_DESCRIPTION">Mantenha o <ph name="PRODUCT_NAME"/> ao lado da página ativa num espaço de trabalho dedicado.</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">Mostrar logótipo do motor de pesquisa</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">Comece a usar o Chromium</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">Configure o Chromium num minuto: importe os seus dados, escolha uma disposição e ajuste o seu Novo separador.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">Passo 1. Traga as suas coisas</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">Importe marcadores, palavras-passe e definições de outro navegador — sem necessidade de conta.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">Importar</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_SKIP">Ignorar por agora</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_MICROCOPY">A importação acontece localmente no seu dispositivo.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">Passo 2. Escolha a sua disposição</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">Escolha o estilo de separadores que se adapta à sua forma de trabalhar. Pode mudar a qualquer momento.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">Separadores laterais</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">Os seus separadores, barra de endereço e ferramentas numa única barra lateral vertical.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">Barra lateral compacta</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">Barra lateral com ícones em primeiro plano que se expande ao passar o cursor — ideal para ecrãs mais pequenos.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">Separadores superiores</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">Separadores clássicos no topo, para uma disposição familiar ao estilo do Chrome.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">Separadores superiores compactos</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">Uma disposição superior mais fina que deixa mais espaço para o que importa: a página.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">As alterações de disposição são aplicadas instantaneamente.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">Aplicar disposição</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">Passo 3. Personalize o seu Novo separador</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">Mantenha-o simples ou mantenha a pesquisa em destaque.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">Mostrar caixa de pesquisa no Novo separador</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">A caixa de pesquisa está visível</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">O Novo separador permanece sem distrações</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">A sua pesquisa, o seu visual</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">Se escolher uma pesquisa predefinida que não seja a do Google, o Chromium atualiza automaticamente a identidade visual do Novo separador.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_TITLE">Passo 4. Ferramentas avançadas integradas</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_DESCRIPTION">O Chromium inclui extensões integradas opcionais. O controlo é seu.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_TITLE">uBlock Origin</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_STATUS">Ativado por predefinição</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_DESCRIPTION">Bloqueio de conteúdo eficiente para uma web mais rápida e limpa.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_TITLE">Tampermonkey (Legado)</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_STATUS">Desativado por predefinição</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_DESCRIPTION">Gestor avançado de userscripts para uma personalização profunda dos sites.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_MANAGE_BUTTON">Gerir extensões</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_FOOTNOTE">Algumas ferramentas integradas podem diferir da disponibilidade na Chrome Web Store.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">Passo 5. Está tudo pronto</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">Muito bem. Quer ir mais longe? Explore mais funcionalidades a seguir.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">Abrir Novo separador</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">Ir para as Definições</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">Extensões →</translation>
