      </message>
      <message name="IDS_NEXUS_SETTINGS_RESET_DIALOG_BODY" desc="Dialog body shown before resetting a provider connection on the Nexus settings page" use_name_for_id="true">
        This clears the saved connection details for <ph name="PROVIDER_NAME">$1</ph>, removes the verified state, and restores the default values for this provider.
      </message>
      <message name="IDS_NEXUS_SETTINGS_RESET_COMPLETED" desc="Accessibility announcement after resetting a provider connection on the Nexus settings page" use_name_for_id="true">
