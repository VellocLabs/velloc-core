module nexus.mojom;

import "mojo/public/mojom/base/values.mojom";

enum NexusLlmRole {
  kSystem,
  kUser,
  kAssistant,
  kTool,
};

enum NexusLlmContentPartType {
  kText,
  kImage,
  kThinking,
  kRedactedThinking,
  kToolUse,
  kToolResult,
};

enum NexusLlmFinishReason {
  kStop,
  kLength,
  kContentFilter,
  kToolCalls,
  kError,
  kOther,
  kUnknown,
};

enum NexusLlmStreamEventType {
  kMessageStart,
  kTextDelta,
  kReasoningDelta,
  kToolCallStart,
  kToolCallDelta,
  kToolCall,
  kFinish,
  kError,
};

struct NexusLlmSelection {
  string provider_id;
  string model_id;
};

struct NexusLlmModel {
  string id;
  string label;
  bool enabled;
  bool supports_streaming;
  bool supports_tools;
  string? default_thinking_tier;
  array<string> available_thinking_tiers;
};

struct NexusLlmProvider {
  string id;
  string label;
  string icon_svg;
  bool enabled;
  string? default_model_id;
  array<NexusLlmModel> models;
};

struct NexusLlmCatalog {
  array<NexusLlmProvider> providers;
  NexusLlmSelection? default_selection;
  map<string, string> raw_catalogs;
};

struct NexusLlmUsage {
  int32 prompt_tokens;
  int32 completion_tokens;
  int32 cache_read_input_tokens;
  int32 cache_creation_input_tokens;
};

struct NexusLlmTool {
  string name;
  string? description;
  mojo_base.mojom.DictionaryValue input_schema;
  // Opt into provider-side grammar-constrained sampling (Anthropic
  // "Strict tool use", OpenAI "Structured Outputs"). When true, the
  // model literally cannot emit a tool_use block whose `input`
  // violates `input_schema`. The provider bridges (anthropic_provider,
  // openai_provider) forward this onto their wire payload; Google and
  // Ollama don't have an equivalent flag and ignore the field.
  bool strict = false;
  // Optional canonical example calls. Each entry is a JSON-Schema-
  // valid `input` dict (matches `input_schema`). Anthropic's
  // `tool_use` API accepts these on the `input_examples` field of a
  // tool definition (see Anthropic docs: "Providing tool use
  // examples"). Other providers (OpenAI / Google / Ollama) don't
  // accept this field and the bridge silently drops it for them.
  // Examples must validate against `input_schema`; Anthropic returns
  // a 400 if any entry violates the schema.
  mojo_base.mojom.ListValue? input_examples;
};

struct NexusLlmContentPart {
  NexusLlmContentPartType type;
  string? text;
  string? image;
  string? mime_type;
  string? signature;
  string? tool_use_id;
  string? name;
  mojo_base.mojom.Value? input;
  mojo_base.mojom.Value? result;
  bool? is_error;
};

struct NexusLlmMessage {
  NexusLlmRole role;
  array<NexusLlmContentPart> content;
};

struct NexusLlmRequestParams {
  array<NexusLlmMessage> messages;
  mojo_base.mojom.Value? system_prompt;
  mojo_base.mojom.DictionaryValue? user_context;
  mojo_base.mojom.DictionaryValue? system_context;
  string? provider_id;
  string? model_id;
  int32? max_output_tokens;
  mojo_base.mojom.DictionaryValue? provider_body_extension;
  array<NexusLlmTool> tools;
  mojo_base.mojom.DictionaryValue? tool_use_context;
};

struct NexusLlmAssistantMessage {
  array<NexusLlmContentPart> content;
  string? model_id;
  NexusLlmFinishReason finish_reason;
  NexusLlmUsage usage;
};

struct NexusLlmCallResult {
  NexusLlmAssistantMessage message;
  // Optional host-side outcome: "ok" (normal), "timeout" (native deadline
  // fired before OnGenerateComplete). Absent on hosts that predate the
  // native-deadline contract.
  string? status;
  // Optional host-captured epoch-ms stamps for each hop
  // (t_recv_native / t_host_read / t_resolve) so the JS guest can log
  // end-to-end latency without an extra round-trip.
  mojo_base.mojom.DictionaryValue? timeline;
};

struct NexusLlmStreamEvent {
  NexusLlmStreamEventType type;
  string? model_id;
  string? text_delta;
  string? tool_use_id;
  string? name;
  string? args_text_delta;
  mojo_base.mojom.Value? input;
  NexusLlmFinishReason? finish_reason;
  NexusLlmUsage? usage;
  string? error_message;
};

struct NexusLlmStreamReadResult {
  array<NexusLlmStreamEvent> events;
  bool done;
  // Optional host-side outcome for this read: "ok" (data or legacy poll),
  // "done" (stream terminal), "timeout" (hold window expired with no new
  // data — host also cancels the upstream loader).
  string? status;
  // Optional host-captured epoch-ms stamps (t_recv_native / t_host_read /
  // t_resolve) so the JS guest can log end-to-end latency.
  mojo_base.mojom.DictionaryValue? timeline;
};

// NOTE: This file is "data types only" — the LLM bridge is dispatched via
// the standard NexusBridgePortService capability handler pattern (same as
// fs/* — see nexus_llm_bridge_adapter.cc), not via a Mojo interface. The
// structs above are used as typed value carriers in C++ (the
// mojom-generated *Ptr types) and as the on-the-wire JSON shape posted
// over the bridge to nexus_web. There is intentionally no `interface`
// declaration here.
