  <translation id="IDS_NEXUS_SETTINGS_OLLAMA_MODEL_HINT">अपने Ollama इंस्टेंस से मॉडल लोड करने के लिए बेस URL सहेजें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_AUTOMATIC_MODEL_HINT">मौजूदा प्रदाता सेटिंग से मॉडल अपने आप लोड हो जाते हैं।</translation>
  <translation id="IDS_NEXUS_SETTINGS_SAVE_PROVIDER_MODEL_HINT">उपलब्ध मॉडल लोड करने के लिए प्रदाता सेटिंग सहेजें।</translation>
  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_LABEL">कनेक्शन</translation>
  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_TEST_LABEL">कनेक्शन जाँच</translation>
  <translation id="IDS_NEXUS_SETTINGS_VALIDATE_TITLE">मौजूदा कॉन्फ़िगरेशन की पुष्टि करें</translation>
  <translation id="IDS_NEXUS_SETTINGS_VALIDATE_DESCRIPTION">मौजूदा प्रदाता सेटिंग सहेजता है और चुने गए मॉडल की जाँच करता है।</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_READY">मौजूदा सेटिंग इस्तेमाल के लिए तैयार है।</translation>
