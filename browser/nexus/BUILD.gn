# Which shells the host can run, and the shell name the guest prompt's
# `Shell:` line carries. A //base-only leaf shared by `fs` (systemInfo) and
# `bridge` (`exec.listShells`), so the two never disagree.
source_set("host_shell") {
  sources = [
    "api/shell/host_shell.cc",
    "api/shell/host_shell.h",
  ]

  deps = [ "//base" ]
}

# The egress policy every network.* request runs under (public hosts only:
# loopback / private / link-local / CGNAT / multicast refused on the IP the
# socket connected to). Pure functions over net::IPAddress and GURL — a leaf
# so the lite test binary links it without the bridge. Also the guest-request
# checks every network.* surface shares (header validity, the finalUrl a
# {{secret:NAME}} query value is redacted from).
source_set("network_egress_policy") {
  sources = [
    "api/network/network_egress_policy.cc",
    "api/network/network_egress_policy.h",
    "api/network/nexus_guest_request.cc",
    "api/network/nexus_guest_request.h",
  ]

  deps = [
    "//base",
    "//net",
    "//url",
  ]
}

source_set("fs") {
  sources = [
    "api/fs/nexus_fs_host.cc",
    "api/fs/nexus_fs_host.h",

    # fs.watch: the per-connection watch set (base::FilePathWatcher + a
    # snapshot-poll fallback, debounced). //base only.
    "api/fs/nexus_fs_watcher.cc",
    "api/fs/nexus_fs_watcher.h",
  ]

  deps = [
    ":host_shell",
    "//base",
    "//mojo/public/cpp/base",
  ]
}

# `sqlite` bridge capability engine: the sequence-affine connection wrapper
# over sql::Database (read/write a SQLite file from the guest). A leaf
# (//base + //sql + //third_party/sqlite) so the adapter in `bridge` links it
# without extra weight. The direct //third_party/sqlite dep is for
# sqlite3_bind_parameter_count (validating guest param counts before binding).
source_set("sqlite") {
  sources = [
    "api/sqlite/nexus_sqlite_connection.cc",
    "api/sqlite/nexus_sqlite_connection.h",
  ]

  deps = [
    "//base",
    "//sql",
    "//third_party/sqlite",
  ]
}

# Span-index transcript search: the structural JSONL indexer + the
# mmap-backed search engine behind the `search` bridge capability.
# Deliberately a leaf (//base + re2 only) so the lite unit-test binary
# links it without dragging in `bridge`.
source_set("transcript_search") {
  sources = [
    "search/transcript_search_engine.cc",
    "search/transcript_search_engine.h",
    "search/transcript_span_index.cc",
    "search/transcript_span_index.h",
    "search/transcript_span_index_file.cc",
    "search/transcript_span_index_file.h",
  ]

  public_deps = [ "//base" ]

  deps = [ "//third_party/re2" ]
}

# Remote access (F-24): a default-OFF in-process relay that reverse-proxies the
# guest origin's build entry and exposes `/rt`, so a remote browser can join
# this desktop's runtime with scope <= control.
source_set("remote_access") {
  sources = [
    "remote_access/nexus_remote_access_listener.cc",
    "remote_access/nexus_remote_access_listener.h",
    "remote_access/remote_access_router.cc",
    "remote_access/remote_access_router.h",
  ]

  deps = [
    "//base",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]

  # Deliberately NOT //chrome/browser/ui: the listener must not depend on the
  # UI layer (see the ui -> settings_handler -> bridge -> ui cycle documented
  # on `:shell_launcher`, BUILD.gn above).
}

# The process-wide "is remote access up, and how many devices are connected"
# registry (F-24). A leaf (//base only) on purpose: the per-Profile service
# pushes into it, and the launcher's tray tooltip + quit confirmation read it,
# without either depending on the other — the launcher must not see
# //chrome/browser/profiles, and the service must not see the launcher.
source_set("remote_access_clients") {
  sources = [
    "remote_access/nexus_remote_access_clients.cc",
    "remote_access/nexus_remote_access_clients.h",
  ]

  deps = [ "//base" ]
}

# The profile-level singleton behind the remoteAccess bridge capability.
# UI thread: prefs, listener start/stop, the reverse proxy's
# OUTBOUND SimpleURLLoaders, and the Local-Network-Access grant for the guest
# origin. Kept OUT of the `remote_access` set above because it needs Profile
# + HostContentSettingsMap + the guest config — //chrome/browser territory the
# IO-thread listener must never see. `bridge` deps on this.
source_set("remote_access_service") {
  sources = [
    "remote_access/nexus_remote_access_service.cc",
    "remote_access/nexus_remote_access_service.h",
  ]

  deps = [
    ":guest_config",
    ":interface_version",
    ":remote_access",
    ":remote_access_clients",
    "//base",
    "//chrome/browser/content_settings",
    "//chrome/browser/profiles:profile",
    "//components/content_settings/core/browser",
    "//components/prefs",
    "//content/public/browser",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

# Minimal source_set holding just `ToolParameter` / `ToolSchema` / the
# JsonSchemaKind enum. Extracted out of `bridge` so the `unit_tests_lite`
# target can link these symbols (needed by the codegen smoke test in
# codegen/) without dragging in the rest of the bridge — which
# pulls in //chrome/browser, content::, mojom bindings, and the actor
# stack. Kept header-only-clean so the extraction stays cheap.

# At-rest secret encryption (os_crypt_async wrapper) shared by the LLM
# provider-config path + the MCP server store. Small standalone set so the
# providers / adapter / settings handler can all depend on it without a
# cycle.
source_set("secret_crypt") {
  sources = [
    "nexus_secret_crypt.cc",
    "nexus_secret_crypt.h",
  ]

  public_deps = [
    "//base",
    "//components/os_crypt/async/common",
  ]

  deps = [ "//components/os_crypt/async/browser" ]
}

# The `alarms` capability's schedule rules (due / catch-up / grid / prefs
