  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR_DESCRIPTION">Onglets verticaux dans la barre latérale.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR">Onglets en barre latérale · Compact</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR_DESCRIPTION">Onglets verticaux réduits aux icônes dans la barre latérale.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD">Onglets en haut</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD_DESCRIPTION">Onglets horizontaux dans la barre supérieure.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD">Onglets en haut · Compact</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD_DESCRIPTION">Onglets horizontaux qui apparaissent au survol.</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_NTP_SECTION_TITLE">Nouvel onglet</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_SEARCH">Afficher le champ de recherche</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">Afficher le logo du moteur de recherche</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SEARCH_ENGINE">Moteur de recherche</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_BODY">Prenez en main votre nouvel onglet. Astuces et raccourcis pour le personnaliser.</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_ACTION">Ouvrir le guide de démarrage</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOADING">Chargement…</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TITLE">Démarrage</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BODY">Commencez ici</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">Démarrer avec Chromium</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">Configurez Chromium en une minute : importez vos données, choisissez une disposition et réglez votre nouvel onglet.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">Étape 1. Emportez vos données</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">Importez favoris, mots de passe et paramètres depuis un autre navigateur — sans compte.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">Importer</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">Étape 2. Choisissez votre disposition</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">Choisissez le style d’onglets qui correspond à votre façon de travailler. Vous pouvez en changer à tout moment.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">Onglets en barre latérale</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">Vos onglets, la barre d’adresse et les outils réunis dans une barre latérale verticale.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">Barre latérale compacte</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">Barre latérale à icônes qui se déploie au survol — idéale sur les petits écrans.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">Onglets en haut</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">Les onglets classiques en haut de la fenêtre, comme dans Chrome.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">Onglets compacts en haut</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">Une disposition supérieure plus fine, qui laisse plus de place à l’essentiel : la page.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">Les changements de disposition s’appliquent immédiatement.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">Appliquer la disposition</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">Étape 3. Personnalisez votre nouvel onglet</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">Gardez-le épuré, ou mettez la recherche en avant.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">Afficher le champ de recherche sur le nouvel onglet</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">Le champ de recherche est visible</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">Le nouvel onglet reste sans distraction</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">Votre recherche, votre style</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">Si vous choisissez un moteur de recherche par défaut autre que Google, Chromium adapte automatiquement l’identité visuelle du nouvel onglet.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">Étape 4. Vous êtes prêt</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">Bien joué. Envie d’aller plus loin ? Découvrez d’autres fonctionnalités.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">Ouvrir un nouvel onglet</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">Aller aux paramètres</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">Extensions →</translation>
