# See README.md in this directory for full design and flow.
import("//chrome/common/features.gni")
import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/webui_features.gni")
assert(enable_custom_browser)

build_webui("build") {
  grd_prefix = "patch_webui"
  static_files = [
    "./customize-chrome-side-panel.top-chrome/custom_main.css",
    "./new-tab-page/get_started.html",
  ]
  ts_files = [
    "./customize-chrome-side-panel.top-chrome/custom_main.ts",
    "./customize-chrome-side-panel.top-chrome/layout_section.ts",
    "./customize-chrome-side-panel.top-chrome/new_tab_page_section.ts",
    "./settings/custom_main.ts",
    "./settings/about/about_patch.ts",
    "./settings/appearance/appearance_patch.ts",
    "./settings/get-started/get_started_patch.ts",
    "./settings/get-started/get_started_page.ts",
    "./extensions/builtin_extensions.ts",
    "./new-tab-page/custom_new_tab.ts",
    "./new-tab-page/get_started.ts",
    "./version/version_patch.ts",
  ]
  extra_grdp_files = [
    "$target_gen_dir/new-tab-page/icons/resources.grdp",
  ]
  extra_grdp_deps = [
    "new-tab-page/icons:build_grdp",
  ]
  ts_composite = true
  ts_definitions = [
    "//tools/typescript/definitions/metrics_private.d.ts",
    "//tools/typescript/definitions/chrome_event.d.ts",
    "//tools/typescript/definitions/settings_private.d.ts",
  ]
  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//chrome/browser/resources/settings:build_ts",
    "//chrome/browser/resources/side_panel/customize_chrome:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/cr_components/color_change_listener:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  ts_path_mappings =
      [ "chrome://customize-chrome-side-panel.top-chrome/shared/*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/side_panel/shared/tsc/*",
            target_gen_dir),
        "chrome://customize-chrome-side-panel.top-chrome/*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/side_panel/customize_chrome/tsc/*",
            target_gen_dir),
        "chrome://settings/*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/settings/tsc/*",
            target_gen_dir) ]
  webui_context_type = "trusted"
}
