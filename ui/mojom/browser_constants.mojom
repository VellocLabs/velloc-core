enum IntKey {
  kUIMode, /* key for UIMode enum */
  // Retired, do not reuse: sized the shell-side kNexus <cr-splitter>,
  // which moved into the React guest (localStorage
  // 'shift-webview-area-width'). Stale persisted ints are ignored.
  kNexusViewWidth,
  kGlobalEnd = 1000, /*End of global keys.*/
  kLeftPanelWidth,
};

enum BoolKey {
  kGlobalEnd = 1000, /*End of global keys.*/
  kLeftPanelLocked,
};

// The following are names of some specific view area, or specific UI elements.
const string kLocationBarAutoSizeViewName = "location-bar-auto-size-view";
const string kMainContentsViewName = "main-contents-view";
const string kViewsContainerViewName = "views-container-view";
const string kNewTabToolbarButtonViewName = "new-tab-toolbar-button";

// v6: kNexus main-contents-view became a guest-driven absolute overlay
// (position synced from nexus_web's per-session webview_area; hidden by
// default until the guest reports). Persisted v5 layouts encode the old
// flex-child geometry with visible:true and must not be restored.
const int32 kUIVersion = 6;
