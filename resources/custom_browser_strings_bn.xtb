  <translation id="IDS_NEXUS_QUIT_REMOTE_DEVICES_BODY">{COUNT, plural, =1 {রিমোট অ্যাক্সেসের মাধ্যমে #টি ডিভাইস সংযুক্ত আছে। প্রস্থান করলে এটি বিচ্ছিন্ন হয়ে যাবে।} other {রিমোট অ্যাক্সেসের মাধ্যমে #টি ডিভাইস সংযুক্ত আছে। প্রস্থান করলে সেগুলি বিচ্ছিন্ন হয়ে যাবে।}}</translation>
