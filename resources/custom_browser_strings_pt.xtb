  <translation id="IDS_NEXUS_CONSENT_TITLE">OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_CONSENT_BODY">Ative o OpenClaw in Chrome para automatizar tarefas do navegador, gerar conteúdo e interagir com páginas da web usando o provedor de IA de sua preferência.</translation>
  <translation id="IDS_NEXUS_CONSENT_ACCEPT">Ativar OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_SETTINGS_TITLE">OpenClaw in Chrome</translation>
