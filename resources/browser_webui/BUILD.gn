


import("//ash/webui/tools/mwc_path_mappings.gni")
import("//chrome/common/features.gni")
import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/webui_features.gni")
assert(enable_custom_browser)

build_webui("build") {
  grd_prefix = "custom_browser"

  # Custom Nexus WebUI predates Chromium 149's stricter type-aware
  # @webui-eslint rules (lit-element-structure, no-mixed-type-and-value-imports,
  # etc.). tsc type-checking still runs; only the style lint gate is skipped.
  enable_type_aware_eslint_checks = false

  static_files = [
    "components/tab_indicators/alert_indicators/picture_in_picture_alt.svg",
    "components/tab_indicators/alert_indicators/serial_port.svg",
    "components/tab_indicators/alert_indicators/tab_audio_muting_rounded.svg",
    "components/tab_indicators/alert_indicators/tab_audio_rounded.svg",
    "components/tab_indicators/alert_indicators/tab_bluetooth_connected.svg",
    "components/tab_indicators/alert_indicators/tab_hid_connected.svg",
    "components/tab_indicators/alert_indicators/tab_media_capturing_with_arrow.svg",
    "components/tab_indicators/alert_indicators/tab_media_recording.svg",
    "components/tab_indicators/alert_indicators/tab_usb_connected.svg",
    "components/tab_indicators/alert_indicators/vr_headset.svg",
    "components/nexus/anthropic.svg",
    "components/nexus/custom.svg",
    "components/nexus/deepseek.svg",
    "components/nexus/githubcopilot.svg",
    "components/nexus/glm.svg",
    "components/nexus/google.svg",
    "components/nexus/kimi.svg",
    "components/nexus/minimax.svg",
    "components/nexus/ollama.svg",
    "components/nexus/openai.svg",
    "components/nexus/qwen.svg",
    "pages/index.html",
  ]

  # Files holding a Polymer/Lit element definition and have an equivalent .html file.
  web_component_files = [
    "components/tab_indicators/alert_indicator.ts",
    "components/tab_indicators/alert_indicators.ts",
  ]

  ts_files = [
    "components/native/native_view_aliases.ts",
    "pages/index.ts",
    "pages/vertical/vertical_page.ts",
    "pages/vertical/vertical_topbar.ts",
    "pages/vertical/vertical_sidebar.ts",
    "pages/vertical_compact/vertical_compact_page.ts",
    "pages/vertical_compact/vertical_compact_topbar.ts",
    "pages/horizontal_compact/horizontal_compact_page.ts",
    # Phase 4: the topbar + settings UI (nexus_topbar, nexus_quick_settings,
    # nexus_settings*, and their *_client / *_panel_client / nexus_panel_bridge
    # / nexus_icons deps) moved into the React guest (`nexus_web/`). The panel
    # is now a thin host: webview + session-state plumbing.
    "pages/nexus/nexus_shared.ts",
    "pages/nexus/nexus_webui_bridge.ts",
    "pages/nexus/nexus_session_state_client.ts",
    "pages/nexus/nexus_ui_event_client.ts",
    "pages/nexus/nexus_bg_tabs_strip.ts",
    "pages/nexus/nexus_view.ts",
    "pages/nexus/nexus_welcome.ts",
    "pages/nexus/nexus_guest_recovery.ts",
    "pages/nexus/nexus_page.ts",
    "pages/nexus/nexus_runtime_bootstrap.ts",
    "pages/nexus/nexus_session_list.ts",
    "controller/tabs_controller.ts",
    "components/tabs_panel/types.ts",
    "components/tabs_panel/tab_hover_preview_controller.ts",
    "components/tabs_panel/vertical_tab_list/custom_scrollbar.ts",
    "components/tabs_panel/vertical_tab_list/cr_url_list_item_ex.ts",
    "components/tabs_panel/vertical_tab_list/tab_item.ts",
    "components/tabs_panel/vertical_tab_list/tab_item.html.ts",
    "components/tabs_panel/vertical_tabs_panel.ts",
    "components/native/native_view_holder.ts",
    "components/native/native_view_batcher.ts",
    "ui_store.ts",
    "utils/mouse_capture_util.ts",
    "utils/hover_swap_util.ts",
    "error_reporter.ts",
    "browser_api_proxy.ts",
  ]

  mojo_files_deps = [
    "//custom_browser/ui/mojom:mojo_bindings_ts__generator",
    "//custom_browser/browser/nexus/mojom:mojom_ts__generator",
    "//components/tabs/public/mojom:mojom_ts__generator",
    "//components/tab_groups/public/mojom:mojo_bindings_ts__generator",
  ]
  mojo_files = [
    "$root_gen_dir/custom_browser/ui/mojom/browser_command_ids.mojom-webui.ts",
    "$root_gen_dir/custom_browser/ui/mojom/browser_controller.mojom-webui.ts",
    "$root_gen_dir/custom_browser/ui/mojom/browser_constants.mojom-webui.ts",
    "$root_gen_dir/custom_browser/ui/mojom/ui_view_controller.mojom-webui.ts",
    "$root_gen_dir/custom_browser/browser/nexus/mojom/nexus_bridge_bootstrap.mojom-webui.ts",
    "$root_gen_dir/components/tabs/public/mojom/tabs.mojom-webui.ts",
    "$root_gen_dir/components/tab_groups/public/mojom/tab_group_types.mojom-webui.ts",
  ]

  # ts_tsconfig_base = "tsconfig_base.json"

  ts_path_mappings = []
  foreach(_mwc_mapping, mwc_path_mappings) {
    ts_path_mappings +=
        [ _mwc_mapping[0] + "|" + rebase_path(_mwc_mapping[1], target_gen_dir) ]
  }

  # print(ts_path_mappings)

  ts_composite = true
  ts_definitions = [
    "//tools/typescript/definitions/metrics_private.d.ts",
    "//tools/typescript/definitions/chrome_event.d.ts",
    "//tools/typescript/definitions/settings_private.d.ts",
  ]
  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/cr_components/color_change_listener:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"
}
