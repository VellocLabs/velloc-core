  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_FAILED">연결에 실패했습니다</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_LABEL">사용자 지정 <ph name="PRODUCT_NAME"/> 웹 앱 URL</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_PLACEHOLDER">https://your-app.example.com</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_URL_RESET">기본값으로 되돌리기</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_PAGE_TITLE">에이전트 웹 앱 URL</translation>
