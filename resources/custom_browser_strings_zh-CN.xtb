  <translation id="IDS_NEXUS_PERMISSION_FILES_BODY">此代理希望读取和写入你计算机上的文件。</translation>
  <translation id="IDS_NEXUS_PERMISSION_CLIPBOARD_TITLE">剪贴板访问</translation>
  <translation id="IDS_NEXUS_PERMISSION_CLIPBOARD_BODY">此代理希望访问你的剪贴板。</translation>
  <translation id="IDS_NEXUS_PERMISSION_BROWSER_DATA_TITLE">浏览器数据访问</translation>
  <translation id="IDS_NEXUS_PERMISSION_BROWSER_DATA_BODY">此代理希望访问你的书签、历史记录和下载内容。</translation>
  <translation id="IDS_NEXUS_PERMISSION_NOTIFICATIONS_TITLE">通知</translation>
  <translation id="IDS_NEXUS_PERMISSION_NOTIFICATIONS_BODY">此代理希望向你发送通知。</translation>
  <translation id="IDS_NEXUS_PERMISSION_ALLOW">允许</translation>
  <translation id="IDS_NEXUS_PERMISSION_DENY">拒绝</translation>
  <translation id="IDS_NEXUS_SETUP_PROVIDER_TITLE">设置你的 AI 提供方</translation>
  <translation id="IDS_NEXUS_SETUP_PROVIDER_BODY">选择一个 AI 提供方并输入你的凭据即可开始。</translation>
  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_1">此功能直接在浏览器中运行 <ph name="PRODUCT_NAME"/>，将 WhatsApp、Telegram、Discord 和 iMessage 等应用连接到 AI 编程助手。</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_DESCRIPTION"><ph name="PRODUCT_NAME"/> 可使用多种 LLM 提供方。选择一个提供方，完成身份验证，然后设置默认模型。</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_ROW_SUBLABEL"><ph name="PRODUCT_NAME"/> 可使用多种 LLM 提供方。选择一个提供方，完成身份验证，然后设置默认模型。</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_CONNECTION_DESCRIPTION">选择 <ph name="PRODUCT_NAME"/> 应连接的服务并验证连接。</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_ROW_SUBLABEL">配置 <ph name="PRODUCT_LONG_NAME"/> 使用的 Web 应用 URL。</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DESCRIPTION">设置自定义的 <ph name="PRODUCT_NAME"/> Web 应用 URL。留空以使用默认体验。</translation>
  <translation id="IDS_NEXUS_SETTINGS_OLLAMA_NOTE">无需 API 密钥。<ph name="PRODUCT_LONG_NAME"/> 会从已配置的 Ollama 服务器加载模型。</translation>
  <translation id="IDS_NEXUS_SETTINGS_NO_PROVIDER_STATE">此配置文件没有可用的 <ph name="PRODUCT_LONG_NAME"/> 提供方信息。</translation>
  <translation id="IDS_NEXUS_SETTINGS_SELECT_PROVIDER">选择一个提供方</translation>
  <translation id="IDS_NEXUS_SETTINGS_CONNECTION_SECTION_TITLE">提供方</translation>
  <translation id="IDS_NEXUS_SETTINGS_PROVIDER_EMPTY_STATE">选择一个提供方，输入连接详情，然后验证以加载模型。</translation>
  <translation id="IDS_NEXUS_SETTINGS_VERIFY_LOAD_MODELS">验证并加载模型</translation>
  <translation id="IDS_NEXUS_SETTINGS_RESET_PROVIDER">重置提供方</translation>
