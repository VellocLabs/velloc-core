  <translation id="IDS_NEXUS_SETTINGS_NO_PROVIDER_STATE">इस प्रोफ़ाइल के लिए <ph name="PRODUCT_LONG_NAME"/> की प्रदाता जानकारी उपलब्ध नहीं है।</translation>
