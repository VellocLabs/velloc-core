  <translation id="IDS_NEXUS_SETTINGS_SAVE_SUCCESS">服务商设置已保存。</translation>
  <translation id="IDS_NEXUS_SETTINGS_RESET_CONNECTION">重置连接</translation>
  <translation id="IDS_NEXUS_SETTINGS_RESET_DIALOG_TITLE">重置 <ph name="PROVIDER_NAME"/> 连接？</translation>
  <translation id="IDS_NEXUS_SETTINGS_RESET_DIALOG_BODY">这会清除已保存的 <ph name="PROVIDER_NAME"/> 连接信息，取消其已验证状态，并将该服务商恢复为默认值。</translation>
  <translation id="IDS_NEXUS_SETTINGS_RESET_COMPLETED"><ph name="PROVIDER_NAME"/> 连接已重置。</translation>
  <translation id="IDS_NEXUS_SETTINGS_RESET_CONFIRM">重置 <ph name="PROVIDER_NAME"/>？

这会移除已存储的服务商、已保存的端点以及已保存的模型选择。</translation>
  <translation id="IDS_NEXUS_SETTINGS_RESET_FAILED">重置服务商设置失败。</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DEFAULT_TITLE">默认行为</translation>
  <translation id="IDS_NEXUS_SETTINGS_WEBAPP_DEFAULT_DESCRIPTION">清除自定义 URL，改用内置的 <ph name="PRODUCT_NAME"/> Web 应用。</translation>
  <translation id="IDS_NEXUS_SYSTEM_MENU_OPEN_BROWSER">打开浏览器窗口</translation>
  <translation id="IDS_NEXUS_SYSTEM_MENU_TASK_MANAGER">任务管理器</translation>
  <translation id="IDS_NEXUS_SYSTEM_MENU_CLOSE_WINDOW">关闭窗口</translation>
  <translation id="IDS_NEXUS_JUMPLIST_NEW_BROWSER_WINDOW">新建浏览器窗口</translation>
  <translation id="IDS_NEXUS_TRAY_REMOTE_ACCESS_DEVICES">{COUNT, plural, other {远程访问：已连接 # 台设备}}</translation>
  <translation id="IDS_NEXUS_QUIT_REMOTE_DEVICES_TITLE">退出 <ph name="PRODUCT_NAME"/>？</translation>
  <translation id="IDS_NEXUS_QUIT_REMOTE_DEVICES_BODY">{COUNT, plural, other {有 # 台设备正通过远程访问连接。退出后它们会断开连接。}}</translation>
  <translation id="IDS_VELLOC_UNINSTALL_DELETE_ALL_DATA">同时删除全部数据（缓存 + <ph name="DATA_DIR"/>）</translation>
  <translation id="IDS_NEXUS_GUEST_RECOVERY_TITLE"><ph name="PRODUCT_NAME"/> 运行时未能加载</translation>
  <translation id="IDS_NEXUS_GUEST_RECOVERY_BODY">面板无法启动运行时。通常是配置的运行时来源无法访问，或它不提供当前版本所需的接口版本。</translation>
  <translation id="IDS_NEXUS_GUEST_RECOVERY_URL_LABEL">已尝试：</translation>
