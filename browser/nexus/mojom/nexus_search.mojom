module nexus.mojom;

import "mojo/public/mojom/base/file_path.mojom";
import "mojo/public/mojom/base/time.mojom";
import "sandbox/policy/mojom/sandbox.mojom";

// Which part of a transcript a hit came from. Mirrors
// `nexus::TranscriptSpanKind`.
enum SearchSpanKind {
  kUserText,
  kAssistantText,
  kSystemText,
  kToolCall,
  kToolResult,
};

struct SearchMatch {
  string session_id;
  string project_dir;
  string transcript_path;
  uint32 line_ordinal;
  string message_uuid;
  SearchSpanKind span_kind;
  // Context around the hit, JSON-unescaped and single-line. Byte offsets
  // of the hit within it.
  string snippet;
  int32 match_start;
  int32 match_len;
};

struct SearchResult {
  bool success;
  // Set only on failure; `SEARCH_BAD_PATTERN` for an invalid regex.
  string error_code;
  string error;
  bool superseded;
  bool truncated;
  int32 skipped_files;
  array<SearchMatch> matches;
};

// Span-index search over session transcripts, and owner of their `.sdi`
// sidecars; only this process reads or writes them.
// Security: kNoSandbox because it reads transcripts and writes sidecars under
// `~/.velloc/projects`; no untrusted input beyond the transcript bytes, and no
// browser or network state.
[ServiceSandbox=sandbox.mojom.Sandbox.kNoSandbox]
interface NexusSearchService {
  // Searches `targets` IN THE ORDER GIVEN — the caller owns relevance
  // ranking, and the result preserves that order. Each call also brings
  // every target's sidecar up to date: current ones are reused as-is, an
  // appended transcript costs a tail rescan, and anything else a rebuild.
  QueryTranscripts(array<mojo_base.mojom.FilePath> targets,
                   string query,
                   bool regex,
                   bool case_sensitive,
                   int32 max_results) => (SearchResult result);
};
