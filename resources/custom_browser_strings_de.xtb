  <translation id="IDS_CUSTOM_BROWSER_MODES_HEADER">Layout</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR">Tabs in der Seitenleiste</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_SIDEBAR_DESCRIPTION">Senkrechte Tabs in der Seitenleiste.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR">Tabs in der Seitenleiste · Kompakt</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR_DESCRIPTION">Senkrechte Tabs in der Seitenleiste, nur mit Symbolen.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD">Tabs oben</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_STANDARD_DESCRIPTION">Waagerechte Tabs in der oberen Leiste.</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD">Tabs oben · Kompakt</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_STANDARD_DESCRIPTION">Waagerechte Tabs, die beim Daraufzeigen erscheinen.</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_NTP_SECTION_TITLE">Neuer Tab</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_SEARCH">Suchfeld anzeigen</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SHOW_LOGO">Logo der Suchmaschine anzeigen</translation>
  <translation id="IDS_CUSTOM_BROWSER_CUSTOMIZE_CHROME_SEARCH_ENGINE">Suchmaschine</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_BODY">Leg mit deinem neuen Tab los. Tipps und Verknüpfungen, um ihn einzurichten.</translation>
  <translation id="IDS_CUSTOM_BROWSER_NTP_SETUP_LIST_GET_STARTED_ACTION">Einstiegsleitfaden öffnen</translation>
  <translation id="IDS_CUSTOM_BROWSER_LOADING">Wird geladen …</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TITLE">Erste Schritte</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BODY">Hier geht es los</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_HERO_TITLE">Erste Schritte mit Chromium</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SUBTITLE">Richte Chromium in einer Minute ein: Daten importieren, Layout wählen und den neuen Tab anpassen.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_TITLE">Schritt 1. Bring deine Sachen mit</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_BRING_DESCRIPTION">Importiere Lesezeichen, Passwörter und Einstellungen aus einem anderen Browser – ganz ohne Konto.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_IMPORT_BUTTON">Importieren</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TITLE">Schritt 2. Wähle dein Layout</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_DESCRIPTION">Nimm den Tab-Stil, der zu deiner Arbeitsweise passt. Du kannst jederzeit wechseln.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_TITLE">Tabs in der Seitenleiste</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_SIDEBAR_DESCRIPTION">Deine Tabs, die Adressleiste und die Werkzeuge in einer senkrechten Seitenleiste.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_TITLE">Kompakte Seitenleiste</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_SIDEBAR_DESCRIPTION">Symbolbasierte Seitenleiste, die sich beim Daraufzeigen aufklappt – ideal für kleinere Bildschirme.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_TITLE">Tabs oben</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_TOP_TABS_DESCRIPTION">Klassische Tabs am oberen Rand – das vertraute Chrome-Layout.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_TITLE">Kompakte Tabs oben</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_COMPACT_TOP_TABS_DESCRIPTION">Ein schlankeres Layout oben, das mehr Platz für das Wesentliche lässt: die Seite.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_HINT">Layout-Änderungen wirken sofort.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_LAYOUT_ACTION">Layout übernehmen</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TITLE">Schritt 3. Passe deinen neuen Tab an</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_DESCRIPTION">Halt ihn aufgeräumt – oder die Suche im Vordergrund.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_LABEL">Suchfeld auf dem neuen Tab anzeigen</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_ON">Suchfeld ist sichtbar</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_NEW_TAB_TOGGLE_OFF">Neuer Tab bleibt ablenkungsfrei</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_TITLE">Deine Suche, dein Look</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_SEARCH_BRANDING_DESCRIPTION">Wenn du eine andere Standardsuche als Google wählst, passt Chromium das Branding auf dem neuen Tab automatisch an.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_TITLE">Schritt 4. Integrierte Power-Tools</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_DESCRIPTION">Chromium bringt optionale integrierte Erweiterungen mit. Du behältst die Kontrolle.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_TITLE">uBlock Origin</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_STATUS">Standardmäßig aus</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_UBLOCK_DESCRIPTION">Effizientes Blockieren von Inhalten für ein schnelleres, aufgeräumteres Web.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_TITLE">Tampermonkey (Legacy)</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_STATUS">Standardmäßig aus</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOL_TAMPER_DESCRIPTION">Fortgeschrittene Userscript-Verwaltung für tiefgreifende Anpassungen an Websites.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_MANAGE_BUTTON">Erweiterungen verwalten</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_TOOLS_FOOTNOTE">Manche integrierten Tools können von dem abweichen, was im Chrome Web Store verfügbar ist.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TITLE">Schritt 5. Du bist startklar</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_DESCRIPTION">Gut gemacht. Lust auf mehr? Entdecke als Nächstes weitere Funktionen.</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_PRIMARY">Neuen Tab öffnen</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_SECONDARY">Zu den Einstellungen</translation>
  <translation id="IDS_CUSTOM_BROWSER_GET_STARTED_FINISH_TERTIARY">Erweiterungen →</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_RECOMMENDED">Empfohlen</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_MINIMAL">Minimal</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_COMING_SOON">Demnächst</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_AUTOMATIC">Automatisch</translation>
  <translation id="IDS_CUSTOM_BROWSER_BADGE_ADVANCED">Erweitert</translation>
  <translation id="IDS_CUSTOM_BROWSER_CLOSE">Schließen</translation>
