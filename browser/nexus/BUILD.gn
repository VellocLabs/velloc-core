import("//build/config/chrome_build.gni")
import("//testing/test.gni")

assert(enable_custom_browser)

declare_args() {
  # Directory of the nexus_web checkout whose bridge interface version the
  # ninja-time gate (`:check_interface_version`) verifies against
  # nexus_interface_version.h. Empty = the script derives the sibling
  # checkout from the monorepo layout (<root>/nexus_web).
  nexus_web_dir = ""

  # Escape hatch for builds without a nexus_web checkout (isolated CI):
  # the gate then stamps with a warning instead of verifying the pairing.
  skip_nexus_interface_version_check = false
}

# =============================================================================
# Bridge interface version
#
# The single source of truth is the NEXUS_INTERFACE_VERSION key in
# //custom_browser/VERSION (see docs/agents/nexus-interface-versioning.md);
# `nexus_interface_version.h` wraps the generated
# nexus_interface_version.inc. Release pairing is URL-pinned
# (GetResolvedNexusGuestURL appends /v<N>/); the dev flow (localhost,
# unversioned path) is covered by this ninja-time gate instead: any build
# fails if the sibling nexus_web checkout's committed, GENERATED
# interfaceVersion.gen.ts (regenerate with `check_interface_version.py
# --sync`) declares a different number. The guest-side file is reported
# through a depfile, so editing either side re-runs the check.
# =============================================================================
action("check_interface_version") {
  script = "scripts/check_interface_version.py"

  inputs = [ "//custom_browser/VERSION" ]

  _stamp = "$target_gen_dir/interface_version_check.stamp"
  outputs = [ _stamp ]
  depfile = "$target_gen_dir/interface_version_check.d"

  args = [
    "--version-file",
    rebase_path("//custom_browser/VERSION", root_build_dir),
    "--stamp",
    rebase_path(_stamp, root_build_dir),
    "--depfile",
    rebase_path(depfile, root_build_dir),
  ]
  if (nexus_web_dir != "") {
    args += [
      "--nexus-web-dir",
      rebase_path(nexus_web_dir, root_build_dir),
    ]
  }
  if (skip_nexus_interface_version_check) {
    args += [ "--skip" ]
  }
}

source_set("interface_version") {
  sources = [ "nexus_interface_version.h" ]

  public_deps = [
    # Emits the generated nexus_interface_version.inc the header includes.
    "//custom_browser/common:generate_product_version",
  ]

  deps = [ ":check_interface_version" ]
}

# =============================================================================
# Tool declaration codegen
#
# Reads `tools/declarations/<category>/<name>.tool.json` files and emits
# `$target_gen_dir/tools/<name>.gen.h` headers. Each header declares a
# typed input struct + abstract base class for the corresponding tool.
# Implementations inherit the base class and override `Run<Name>`.
#
# Phase 1 of the declarative tool-definition migration. Only one
# declaration today (`screenshot`); when Phase 3 splits browser_actions
# the inputs/outputs lists below grow correspondingly. See plan
# `giggly-watching-pie.md` for the migration path.
#
# To keep deps tracking precise, both `inputs` (files that influence
# the output) and `outputs` (files emitted) must be enumerated. A
# `*.tool.json` glob would miss new files and break incremental builds.
# =============================================================================
action("nexus_tools_codegen") {
  script = "codegen/generate.py"

  inputs = [
    # The codegen script itself — re-run when this changes.
    "codegen/tool_schema.json",
    "codegen/skill_schema.json",

    # Skill declarations — currently used only for editor validation +
    # codegen-side malformed-shape rejection. Phase 5+ runtime gating
    # will read these to decide which tools to omit from tools[] until
    # Skill('<name>') activates the bucket.
    "tools/declarations/skills/browser.skill.json",

    # Phase 13.2 / 13.7: cross-cutting native-tool prose for the
    # `{{system-prompt-tools}}` placeholder in
    # `nexus_web/public/system_prompts/*.md`. One Markdown file at the
    # top of `tools/declarations/` is the source of truth; codegen
    # reads it verbatim into `system_prompt_tools.gen.h` (a single
    # constexpr string the renderer returns as-is).
    "tools/declarations/system-prompt-tools.md",

    # Phase 13.4: catalog-frame manifest for the `{{TOOL_CATALOG}}`
    # placeholder — group ordering, the "## Browser tools" / "##
    # File and shell tools" headers, and `@file:` references to the
    # prose .md files below. Codegen emits `tool_catalog_frame.gen.h`
    # with constexpr string_views the renderer references, AND seeds
    # `_BROWSER_TOOL_GROUP_ORDER` so the per-tool prompt-entries
    # table sorts in the canonical group order defined here.
    "tools/declarations/tool-catalog-frame.json",

    # Prose blocks for the catalog-frame manifest above. Each .md is loaded
    # by the codegen's `@file:` resolver and embedded as a constexpr string in
    # `tool_catalog_frame.gen.h`. Listed individually so GN re-runs codegen
    # when any block changes. The browser section's catalog .md was relocated
    # to `browser_tool/` (with the browser skill's description + instructions
    # .md — see below) so all three browser prose sources share one folder;
    # the other four sections stay in `tool-catalog-frame/`.
    "tools/declarations/tool-catalog-frame/file-shell-tools.md",
    "tools/declarations/tool-catalog-frame/task-tracking.md",
    "tools/declarations/tool-catalog-frame/skills.md",
    "tools/declarations/tool-catalog-frame/parallelism.md",

    # Browser skill prose, split by audience into three .md under
    # `browser_tool/`, pulled in via `@file:` references:
    #   - browser-tools-catalog.md      → tool-catalog-frame.json `browser_tools`
    #       (Position 2: the system-prompt `## Browser tools` catalog).
    #   - browser-skill-description.md  → browser.skill.json `description`
    #       (Position 1: the 1-line skill-menu advertisement).
    #   - browser-skill-instructions.md → browser.skill.json `instructions`
    #       (Position 3: the workflow playbook injected on activation).
    "tools/declarations/browser_tool/browser-tools-catalog.md",
    "tools/declarations/browser_tool/browser-skill-description.md",
    "tools/declarations/browser_tool/browser-skill-instructions.md",

    # Every *.tool.json declaration. Add a line per new file.
    # Phase 13: collapsed catalog — was 24 tools, now 20. Cuts:
    #   - wait/forward removed (low utility); create_tab merged into navigate
    #     (new_tab boolean); media_play/pause/seek merged into media_control
    #     (action discriminator); BrowserFillForm added for batch form fills.
    "tools/declarations/browser_tool/activate_tab.tool.json",
    "tools/declarations/browser_tool/back.tool.json",
    "tools/declarations/browser_tool/click.tool.json",
    "tools/declarations/browser_tool/close_tab.tool.json",
    "tools/declarations/browser_tool/done.tool.json",
    "tools/declarations/browser_tool/download.tool.json",
    "tools/declarations/browser_tool/drag_and_drop.tool.json",
    "tools/declarations/browser_tool/evaluate.tool.json",
    "tools/declarations/browser_tool/fill_form.tool.json",
    "tools/declarations/browser_tool/find_text.tool.json",
    "tools/declarations/browser_tool/hover.tool.json",
    "tools/declarations/browser_tool/input.tool.json",
    "tools/declarations/browser_tool/media_control.tool.json",
    "tools/declarations/browser_tool/media_state.tool.json",
    "tools/declarations/browser_tool/navigate.tool.json",
    "tools/declarations/browser_tool/read_element.tool.json",
    "tools/declarations/browser_tool/read_page.tool.json",
    "tools/declarations/browser_tool/screenshot.tool.json",
    "tools/declarations/browser_tool/scroll.tool.json",
    "tools/declarations/browser_tool/scroll_to.tool.json",
    "tools/declarations/browser_tool/search.tool.json",
    "tools/declarations/browser_tool/select.tool.json",
    "tools/declarations/browser_tool/upload.tool.json",

    # file_tool category — Claude-Code-style local-filesystem tools.
    # runtime.thread = "ui": the dispatcher invokes each method on UI,
    # and the body hops its blocking disk I/O to base::ThreadPool itself
    # via PostTaskAndReplyWithResult (the per-session FileTool must not be
    # bound onto a worker via base::Unretained — see file_tool.h).
    "tools/declarations/file_tool/edit.tool.json",
    "tools/declarations/file_tool/glob.tool.json",
    "tools/declarations/file_tool/read.tool.json",
    "tools/declarations/file_tool/write.tool.json",

    # process_tool category — UI-thread tools that fire async mojo
    # calls into NexusShellService. Bash runs arbitrary host shell
    # commands; Grep shells out to ripgrep.
    "tools/declarations/process_tool/bash.tool.json",
    "tools/declarations/process_tool/bash_output.tool.json",
    "tools/declarations/process_tool/grep.tool.json",
    "tools/declarations/process_tool/power_shell.tool.json",

    # Bridge-API declarations (Phase 10c). Each *.api.json names a
    # single wire action under one of the categories below. Codegen
    # produces a per-category abstract base (e.g. `FsApiBase`,
    # `LlmApiBase`) whose ctor calls Register(...) for every action,
    # so the hand-written adapter only declares Handle*() overrides.
    # Adding a new action = drop a *.api.json next to its peers and
    # add it to the inputs/outputs lists below.
    "codegen/api_schema.json",

    # fs category — 19 actions, all proxied through NexusFsHost.
    "api/declarations/fs/appendFile.api.json",
    "api/declarations/fs/cwd.api.json",
    "api/declarations/fs/exists.api.json",
    "api/declarations/fs/mkdir.api.json",
    "api/declarations/fs/readBatch.api.json",
    "api/declarations/fs/readFile.api.json",
    "api/declarations/fs/readFileBytes.api.json",
    "api/declarations/fs/readRange.api.json",
    "api/declarations/fs/readdir.api.json",
    "api/declarations/fs/readdirTree.api.json",
    "api/declarations/fs/realpath.api.json",
    "api/declarations/fs/rename.api.json",
    "api/declarations/fs/rm.api.json",
    "api/declarations/fs/stat.api.json",
    "api/declarations/fs/statBatch.api.json",
    "api/declarations/fs/userHome.api.json",
    "api/declarations/fs/systemInfo.api.json",
    "api/declarations/fs/unlink.api.json",
    "api/declarations/fs/writeFile.api.json",
    "api/declarations/sqlite/batch.api.json",
    "api/declarations/sqlite/close.api.json",
    "api/declarations/sqlite/execute.api.json",
    "api/declarations/sqlite/open.api.json",
    "api/declarations/sqlite/query.api.json",

    # llm category — 11 actions, proxied through NexusLlmHost / LlmBroker.
    # Phase 12f moved `publishStatus` out to the new `session` category.
    "api/declarations/llm/call.api.json",
    "api/declarations/llm/catalog.api.json",
    "api/declarations/llm/encryptSecret.api.json",
    "api/declarations/llm/publishBinaryRegistry.api.json",
    "api/declarations/llm/publishCatalog.api.json",
    "api/declarations/llm/publishProviderConfigs.api.json",
    "api/declarations/llm/registerToolDefs.api.json",
    "api/declarations/llm/setDefaultSelection.api.json",
    "api/declarations/llm/streamCancel.api.json",
    "api/declarations/llm/streamRead.api.json",
    "api/declarations/llm/streamStart.api.json",

    # network category — V1 of the WebFetch tool. General-purpose HTTP
    # GET over the Chromium net stack, exposed to TS-side tools that
    # need to fetch URLs without renderer-CORS gating. Wraps
    # `network::SimpleURLLoader` in `NexusNetworkHost`.
    "api/declarations/network/httpGet.api.json",

    # mcp category — native-backed (stdio) MCP server lifecycle. The C++
    # side owns the full MCP client for locally-spawned servers (process
    # launch + JSON-RPC handshake + tools/list + tools/call); the JS
    # MCPPool references each server only by opaque id, so the command /
    # env (incl. secrets) never crosses into the guest. Mirrors the
    # LLM-provider "secrets stay native" template. Backed by
    # `NexusMcpHost` over `NexusShellService`.
    "api/declarations/mcp/callTool.api.json",
    "api/declarations/mcp/connect.api.json",
    "api/declarations/mcp/disconnect.api.json",
    "api/declarations/mcp/listServers.api.json",
    "api/declarations/mcp/testConnect.api.json",

    # shell category — guest-side observe/control for BACKGROUND shells the
    # model spawns via the Bash tool's run_in_background mode (ProcessTool::
    # Spawn). `status` maps onto ReadBackgroundOutput, `kill` onto the Mojo
    # Kill. Both go through the per-Profile shared NexusShellServiceLauncher so
    # they reach the same utility-process registry ProcessTool spawned into.
    # Lets the TS layer surface a backgrounded Bash in the Background Tasks
    # drawer (live status + Stop) WITHOUT going through the model tool loop.
    "api/declarations/shell/kill.api.json",
    "api/declarations/shell/status.api.json",

    # session category — 4 actions (Phase 12f, +setActiveSession).
    # Dedicated capability for SessionStatus + LLM-session lifecycle.
    # `publishStatus` and `onStop` (renamed from `browser.endSession`)
    # plus `setAgentLoopSettings` (renamed from
    # `browser.setAgentLoopSettings`). `setActiveSession` reports the
    # guest's active chat session: activates one of its kNexus-window
    # tabs and returns the tab counts that gate the webview_area.
    # (Named setActiveSession, not setActive — codegen emits all input
    # structs into one `nexus::generated` namespace and providers/
    # setActive.api.json already owns `SetActiveInput`.)
    "api/declarations/session/onStop.api.json",
    "api/declarations/session/publishStatus.api.json",
    "api/declarations/session/setActiveSession.api.json",
    "api/declarations/session/setAgentLoopSettings.api.json",

    # search category — span-index transcript search (Ctrl+K dialog).
    "api/declarations/search/queryTranscripts.api.json",

    # remote_access category — the desktop's embedded-relay status +
    # configure (remote-browser-client plan §8.4). getStatus is the
    # full-trust snapshot (carries the control token); configure applies a
    # partial {enabled, bindAddress, port}. Input structs are globally
    # unique (RemoteAccessGetStatusInput / RemoteAccessConfigureInput).
    # Directory is snake_case like every other category; the capability
    # wire name is camelCase ("remoteAccess") via RegisterCapability.
    "api/declarations/remote_access/configure.api.json",
    "api/declarations/remote_access/getPairings.api.json",
    "api/declarations/remote_access/getStatus.api.json",
    "api/declarations/remote_access/setPairings.api.json",

    # ui category — 14 actions; settings shortcut + boot-state events
    # + open-url + native window title + the guest-webview Inspect
    # context-menu pref. All run on UI (the bridge's home thread).
    # broadcastCurrentSessionState + broadcastSessionsSummary +
    # dismissBootWelcome + showMainContents retired — all four were
    # C++ pass-through relays for events the SharedWorker now fans
    # directly through the WebUI bridge.
    "api/declarations/ui/getBootTimings.api.json",
    "api/declarations/ui/getInspectMenuEnabled.api.json",
    "api/declarations/ui/getProviderMissingPrompt.api.json",
    "api/declarations/ui/openBrowserWindow.api.json",
    "api/declarations/ui/openLanguageSettings.api.json",
    "api/declarations/ui/openNexusSettings.api.json",
    "api/declarations/ui/openUrl.api.json",
    "api/declarations/ui/pickAttachmentFiles.api.json",
    "api/declarations/ui/pickProjectFolder.api.json",
    "api/declarations/ui/revealProjectFolder.api.json",
    "api/declarations/ui/setActiveSessionTitle.api.json",
    "api/declarations/ui/setInspectMenuEnabled.api.json",
    "api/declarations/ui/setWindowDragRegions.api.json",
    "api/declarations/ui/showNotification.api.json",

    # catalog category — 3 actions; replaces the bootstrap manifest's
    # hostedTools field with a lazy-pull API and moves prompt-section
    # rendering (was getUsingYourToolsSection in TS) to C++ as the
    # single source of truth for tool-name knowledge.
    "api/declarations/catalog/listHostedTools.api.json",
    "api/declarations/catalog/listPromptSections.api.json",
    "api/declarations/catalog/registerPromptOverrides.api.json",
    "api/declarations/catalog/renderPromptSection.api.json",

    # providers category — Approach 5 (A5): WebUI panel ↔ C++ bridge
    # port. Used ONLY on the panel WebUI bridge port (not exposed to
    # the SharedWorker / guest). Migrates settings-page chrome.send
    # routes (`getAgentProviders`, etc.) to the bridge protocol one
    # action at a time.
    "api/declarations/providers/beginOAuth.api.json",
    "api/declarations/providers/list.api.json",
    "api/declarations/providers/oauthStatus.api.json",
    "api/declarations/providers/refresh.api.json",
    "api/declarations/providers/reset.api.json",
    "api/declarations/providers/setActive.api.json",
    "api/declarations/providers/update.api.json",
    "api/declarations/providers/verify.api.json",

    # browser_tools category — A5 panel-port-only capability. Replaces
    # the chrome.send `get/setBrowserToolsSeparateWindow` routes. Single
    # field today; the snapshot/setField shape mirrors the existing
    # `agent` and `features` capabilities so adding a future toggle is
    # purely a dict extension.
    "api/declarations/browser_tools/setField.api.json",
    "api/declarations/browser_tools/snapshot.api.json",

    # app_info + system_prefs categories — the React Settings · About and
    # Settings · System pages. Both were missing from this list even though
    # their per-category `*_api.gen.{h,cc}` are declared under `outputs`;
    # generate.py rglobs `api/declarations/`, so the actions were emitted
    # anyway, but ninja had no edge from the declarations to the codegen and
    # would not re-run it when one changed. Listed now so an edit to a
    # declaration regenerates.
    "api/declarations/app_info/getVersionInfo.api.json",
    "api/declarations/app_info/getWebappUrl.api.json",
    "api/declarations/app_info/relaunch.api.json",
    "api/declarations/app_info/setWebappUrl.api.json",
    "api/declarations/system_prefs/get.api.json",
    "api/declarations/system_prefs/setBackgroundMode.api.json",
    "api/declarations/system_prefs/setLauncher.api.json",

    # appearance category — per-client appearance (2026-09-20). resolveTheme
    # resolves a full colour theme for ONE client (no pref write, no
    # broadcast); getAppearance reports the locale + one-release legacy colour
    # fields; setUiLocale writes kApplicationLocale. setColorScheme /
    # setUserColor are DEPRECATED but kept for one release: the /v1/ guest
    # currently served (nexus_web main) still calls them from its
    # Settings · Appearance page, so a binary without them breaks that page.
    # They write the profile theme pref exactly as before; remove them once
    # the per-client guest (resolveTheme + caller-localStorage) is served.
    "api/declarations/appearance/getAppearance.api.json",
    "api/declarations/appearance/resolveTheme.api.json",
    "api/declarations/appearance/setColorScheme.api.json",
    "api/declarations/appearance/setUiLocale.api.json",
    "api/declarations/appearance/setUserColor.api.json",
  ]

  outputs = [
    # Per-tool: one *.gen.h per *.tool.json above, in the same order.
    "$target_gen_dir/tools/activate_tab.gen.h",
    "$target_gen_dir/tools/back.gen.h",
    "$target_gen_dir/tools/click.gen.h",
    "$target_gen_dir/tools/close_tab.gen.h",
    "$target_gen_dir/tools/done.gen.h",
    "$target_gen_dir/tools/download.gen.h",
    "$target_gen_dir/tools/drag_and_drop.gen.h",
    "$target_gen_dir/tools/evaluate.gen.h",
    "$target_gen_dir/tools/fill_form.gen.h",
    "$target_gen_dir/tools/find_text.gen.h",
    "$target_gen_dir/tools/hover.gen.h",
    "$target_gen_dir/tools/input.gen.h",
    "$target_gen_dir/tools/media_control.gen.h",
    "$target_gen_dir/tools/media_state.gen.h",
    "$target_gen_dir/tools/navigate.gen.h",
    "$target_gen_dir/tools/read_element.gen.h",
    "$target_gen_dir/tools/read_page.gen.h",
    "$target_gen_dir/tools/screenshot.gen.h",
    "$target_gen_dir/tools/scroll.gen.h",
    "$target_gen_dir/tools/scroll_to.gen.h",
    "$target_gen_dir/tools/search.gen.h",
    "$target_gen_dir/tools/select.gen.h",
    "$target_gen_dir/tools/upload.gen.h",

    # file_tool category — sorted by tool name within the category to
    # match generate.py's sorted-by-name emission order.
    "$target_gen_dir/tools/edit.gen.h",
    "$target_gen_dir/tools/glob.gen.h",
    "$target_gen_dir/tools/read.gen.h",
    "$target_gen_dir/tools/write.gen.h",

    # process_tool category — UI-thread tools that fire async mojo
    # calls into NexusShellService.
    "$target_gen_dir/tools/bash.gen.h",
    "$target_gen_dir/tools/bash_output.gen.h",
    "$target_gen_dir/tools/grep.gen.h",
    "$target_gen_dir/tools/power_shell.gen.h",

    # Bridge-API codegen (Phase 10c). One <category>_api.gen.{h,cc}
    # pair per category. The .h holds the abstract base class with
    # Handle*() pure virtuals; the .cc holds the ctor body whose
    # Register() calls bind action names to those virtuals. The .h
    # is consumed by the matching adapter header
    # (api/<cat>/nexus_<cat>_bridge_adapter.h); the .cc is compiled
    # into the `bridge` source_set so its FsApiBase / LlmApiBase
    # ctor symbols satisfy the linker.
    "$target_gen_dir/api/fs/fs_api.gen.h",
    "$target_gen_dir/api/fs/fs_api.gen.cc",
    "$target_gen_dir/api/llm/llm_api.gen.h",
    "$target_gen_dir/api/llm/llm_api.gen.cc",
    "$target_gen_dir/api/network/network_api.gen.h",
    "$target_gen_dir/api/network/network_api.gen.cc",
    "$target_gen_dir/api/mcp/mcp_api.gen.h",
    "$target_gen_dir/api/mcp/mcp_api.gen.cc",
    "$target_gen_dir/api/shell/shell_api.gen.h",
    "$target_gen_dir/api/shell/shell_api.gen.cc",
    "$target_gen_dir/api/ui/ui_api.gen.h",
    "$target_gen_dir/api/ui/ui_api.gen.cc",
    "$target_gen_dir/api/catalog/catalog_api.gen.h",
    "$target_gen_dir/api/catalog/catalog_api.gen.cc",
    "$target_gen_dir/api/session/session_api.gen.h",
    "$target_gen_dir/api/session/session_api.gen.cc",
    "$target_gen_dir/api/search/search_api.gen.h",
    "$target_gen_dir/api/search/search_api.gen.cc",
    "$target_gen_dir/api/remote_access/remote_access_api.gen.h",
    "$target_gen_dir/api/remote_access/remote_access_api.gen.cc",
    "$target_gen_dir/api/providers/providers_api.gen.h",
    "$target_gen_dir/api/providers/providers_api.gen.cc",
    "$target_gen_dir/api/browser_tools/browser_tools_api.gen.h",
    "$target_gen_dir/api/browser_tools/browser_tools_api.gen.cc",
    "$target_gen_dir/api/system_prefs/system_prefs_api.gen.h",
    "$target_gen_dir/api/system_prefs/system_prefs_api.gen.cc",
    "$target_gen_dir/api/app_info/app_info_api.gen.h",
    "$target_gen_dir/api/app_info/app_info_api.gen.cc",
    "$target_gen_dir/api/sqlite/sqlite_api.gen.h",
    "$target_gen_dir/api/sqlite/sqlite_api.gen.cc",
    "$target_gen_dir/api/appearance/appearance_api.gen.h",
    "$target_gen_dir/api/appearance/appearance_api.gen.cc",

    # Per-category aggregate: one *.gen.h per UNIQUE folder under
    # declarations/. Holds the abstract base class (e.g.
    # `BrowserToolBase`) whose pure virtuals aggregate every tool in
    # the category. The implementation class inherits this base.
    # Add a line whenever a new declarations/<category>/ folder is
    # introduced.
    "$target_gen_dir/tools/browser_tool.gen.h",
    "$target_gen_dir/tools/file_tool.gen.h",
    "$target_gen_dir/tools/process_tool.gen.h",

    # Combined registry: one .gen.h declaring AllSchemas() +
    # PopulateRegistry(), one .gen.cc defining them. The .gen.cc is the
    # only source-of-record of the combined registry plumbing; it gets
    # compiled into the `bridge` source_set below.
    "$target_gen_dir/tools/nexus_tools_registry.gen.h",
    "$target_gen_dir/tools/nexus_tools_registry.gen.cc",

    # Skill registry: one .gen.h declaring AllSkills(), one .gen.cc
    # defining it (one SkillSchema per *.skill.json under
    # declarations/skills/). Consumed by api/catalog/
    # nexus_catalog_bridge_adapter.cc to serve `catalog.listSkills`.
    "$target_gen_dir/tools/nexus_skills_registry.gen.h",
    "$target_gen_dir/tools/nexus_skills_registry.gen.cc",

    # Phase 13.2: rendered cross-cutting native-tool prose for the
    # `{{system-prompt-tools}}` placeholder. Source .md at
    # tools/declarations/system-prompt-tools.md. Consumed by
    # api/catalog/prompt_section_renderer.cc.
    "$target_gen_dir/tools/system_prompt_tools.gen.h",

    # Phase 13.4 / 13.8 / 13.9: rendered catalog-frame prose for the
    # `{{TOOL_CATALOG}}` placeholder. Source manifest at
    # tools/declarations/tool-catalog-frame.json (references one .md
    # per section). Consumed by api/catalog/prompt_section_renderer.cc
    # via the constexpr string_views `kBrowserToolsContent`,
    # `kFileShellToolsContent`, `kTaskTrackingContent`, `kSkillsContent`,
    # `kParallelismContent`, plus the wire-name arrays
    # `kBrowserToolWireNames` / `kFileShellToolWireNames` (used to gate
    # whether each section is emitted).
    "$target_gen_dir/tools/tool_catalog_frame.gen.h",
  ]

  args = [
    "--declarations-dir",
    rebase_path("tools/declarations", root_build_dir),
    "--output-dir",
    rebase_path("$target_gen_dir/tools", root_build_dir),

    # Bridge-API codegen (Phase 10c). Optional flags; when present, the
    # script ALSO emits one <category>_api.gen.{h,cc} per category under
    # api/declarations/<category>/.
    "--api-declarations-dir",
    rebase_path("api/declarations", root_build_dir),
    "--api-output-dir",
    rebase_path("$target_gen_dir/api", root_build_dir),
  ]
}

