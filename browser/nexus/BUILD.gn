# The one home for "how Velloc restarts". Two surfaces need it — the guest
# bridge's `appInfo.relaunch` (About page) and the panel WebUI's
# `restartBrowser` (guest-recovery overlay) — and they cannot share a
# transport, so they share this instead. Deliberately a LEAF: it must be
# dependable from `:nexus_settings_handler` without dragging
# //chrome/browser/ui back in and re-opening the dependency cycle noted on
# `:mcp_host`.
source_set("client_restart") {
  sources = [
    "nexus_client_restart.cc",
    "nexus_client_restart.h",
  ]

  deps = [
    "//base",

    # chrome::AttemptRestart. Header-only target; the symbol comes from
    # `lifetime:impl`, already linked into chrome via //chrome/browser.
    "//chrome/browser/lifetime",
    "//content/public/browser",
  ]
}

