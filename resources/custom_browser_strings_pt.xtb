  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR">Abas na barra lateral · Compacto</translation>
  <translation id="IDS_CUSTOM_BROWSER_MODE_COMPACT_SIDEBAR_DESCRIPTION">Abas verticais só com ícones na barra lateral.</translation>
