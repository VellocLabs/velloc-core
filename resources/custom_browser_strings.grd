      <!-- Native window system menu (right-click the Nexus window top bar / taskbar thumbnail) -->
      <message name="IDS_NEXUS_SYSTEM_MENU_OPEN_BROWSER" desc="System menu item on the Nexus agent window that opens a regular browser window" use_name_for_id="true">
        Open browser window
      </message>
      <message name="IDS_NEXUS_SYSTEM_MENU_TASK_MANAGER" desc="System menu item on the Nexus agent window that opens the Task Manager" use_name_for_id="true">
