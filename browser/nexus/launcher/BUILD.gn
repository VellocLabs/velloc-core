# Nexus launcher: keeps the browser process alive and shows a system-tray icon
# (Velloc's production logo) so the Nexus window stays reachable when the
# browser is minimized/closed. See P-5.

# Minimal local_state pref registration. Kept deliberately tiny (only
# //components/prefs) so chrome/browser/prefs:impl can depend on it without
# pulling //chrome/browser back into a cycle.
source_set("prefs") {
  sources = [
    "nexus_launcher_prefs.cc",
    "nexus_launcher_prefs.h",
  ]

  deps = [ "//components/prefs" ]
}

# Bridge interface to the UI layer's window-opening logic. Tiny and dependency-
# free so the UI target (//chrome/browser/ui, which owns the implementation via
# custom_browser_view.gni) can link it without a cycle.
source_set("delegate") {
  sources = [
    "nexus_launcher_delegate.cc",
    "nexus_launcher_delegate.h",
  ]

  # base::OnceClosure only (ConfirmQuit). //base depends on nothing above it,
  # so this keeps the target cycle-free.
  public_deps = [ "//base" ]
}

source_set("launcher") {
  sources = [
    "nexus_background_mode_manager.cc",
    "nexus_background_mode_manager.h",
    "nexus_status_icon.cc",
    "nexus_status_icon.h",
  ]

  deps = [
    ":delegate",
    ":prefs",
    "//base",
    # IDR_PRODUCT_LOGO_* (chrome/grit/theme_resources.h) — Velloc's production
    # logo in a branded build.
    "//chrome/app/theme:theme_resources",
    "//chrome/browser:browser_process",
    # browser_shutdown::AddAppTerminatingCallback — releases the keep-alive on
    # a real quit. A //base + //content/public/browser leaf, so no cycle.
    "//chrome/browser/lifetime:termination_notification",
    "//chrome/browser/status_icons",
    # prefs::kBackgroundModeEnabled — the one System toggle the manager keys on.
    "//chrome/common:constants",
    "//components/keep_alive_registry",
    "//components/prefs",
    # The tray tooltip's connected-devices line reads the process-wide
    # remote-access summary (a //base-only leaf, so no cycle).
    "//custom_browser/browser/nexus:remote_access_clients",
    "//custom_browser/chromium_hooks:hook_api",
    "//custom_browser/common:common",
    "//custom_browser/resources:custom_browser_strings",
    "//ui/base",
    "//ui/gfx",
  ]
}
