  <translation id="IDS_NEXUS_SETTINGS_RESET_DIALOG_BODY">Esto borra los datos de conexión guardados de <ph name="PROVIDER_NAME"/>, elimina el estado verificado y restaura los valores predeterminados de este proveedor.</translation>
  <translation id="IDS_NEXUS_SETTINGS_RESET_COMPLETED">Conexión de <ph name="PROVIDER_NAME"/> restablecida.</translation>
