  <translation id="IDS_NEXUS_SETTINGS_SECTION_DESCRIPTION_LINE_1">Esta función ejecuta <ph name="PRODUCT_NAME"/> directamente en el navegador, conectando aplicaciones como WhatsApp, Telegram, Discord e iMessage con asistentes de programación con IA.</translation>
