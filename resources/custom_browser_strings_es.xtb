  <translation id="IDS_NEXUS_CONSENT_TITLE">OpenClaw in Chrome</translation>
  <translation id="IDS_NEXUS_CONSENT_BODY">Activa OpenClaw in Chrome para automatizar tareas del navegador, generar contenido e interactuar con páginas web usando tu proveedor de IA preferido.</translation>
